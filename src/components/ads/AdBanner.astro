---
interface Props {
  type?: 'horizontal' | 'in-article' | 'in-feed' | 'compact' | 'leaderboard';
  slotId?: string;
  client?: string;
  className?: string;
  label?: string;
}

const {
  type = 'horizontal',
  slotId = '1234567890',
  client = 'ca-pub-XXXXXXXXXXXXXXXX',
  className = '',
  label = '추천 스폰서 · AD'
} = Astro.props;

// Ad Mockup Images according to ad format
const mockImages = {
  leaderboard: '/images/ads/mock-leaderboard-cloud.png',
  horizontal: '/images/ads/mock-leaderboard-cloud.png',
  'in-article': '/images/ads/mock-inarticle-cursor.png',
  'in-feed': '/images/ads/mock-inarticle-cursor.png',
  compact: '/images/ads/mock-leaderboard-cloud.png',
};

// Target links for mock showcase
const mockLinks = {
  leaderboard: '/ai-tools',
  horizontal: '/ai-tools',
  'in-article': '/ai-tools',
  'in-feed': '/ai-tools',
  compact: '/ai-tools',
};

const mockImg = mockImages[type] || '/images/ads/mock-leaderboard-cloud.png';
const mockLink = mockLinks[type] || '/ai-tools';
---

<div class={`adsense-wrapper relative overflow-hidden transition-all duration-300 rounded-2xl border border-indigo-500/25 shadow-lg shadow-indigo-950/20 max-w-6xl mx-auto my-3 sm:my-4 ${className}`}>
  <!-- Ad Header Label (Google Policy Compliant) -->
  <div class="flex items-center justify-between px-3 py-1 bg-slate-950/90 border-b border-slate-800/80 text-[10px] text-slate-500 select-none">
    <div class="flex items-center gap-1.5">
      <span class="px-1.5 py-0.2 rounded bg-indigo-500/20 text-indigo-400 font-bold border border-indigo-500/30 text-[9px]">AD</span>
      <span class="text-slate-400 font-medium">{label}</span>
    </div>
    <span class="text-[9px] text-slate-500">Google AdSense · 스폰서 미리보기</span>
  </div>

  <!-- AdSense Container & Live Preview Mock Graphic -->
  <div class="p-1 sm:p-1.5 bg-slate-950/80 backdrop-blur-md flex flex-col items-center justify-center text-center group">
    <!-- Google AdSense Official Tag (Activated when live ad unit ID is provided) -->
    <ins
      class="adsbygoogle w-full block text-center"
      style="display:none"
      data-ad-client={client}
      data-ad-slot={slotId}
      data-ad-format={type === 'in-article' ? 'fluid' : 'auto'}
      data-full-width-responsive="true"
    ></ins>

    <!-- Visual Example Ad Banner (Seamlessly Blends with rab8bit Dark Design) -->
    <a 
      href={mockLink}
      class="block w-full overflow-hidden rounded-xl transition-all duration-300 transform group-hover:scale-[1.008] border border-slate-800 hover:border-indigo-500/50 relative shadow-sm"
      title="스폰서 추천 광고 미리보기"
    >
      <img 
        src={mockImg} 
        alt="스폰서 추천 광고 배너" 
        loading="lazy" 
        class="w-full h-auto object-cover rounded-xl"
      />
    </a>
  </div>
</div>
