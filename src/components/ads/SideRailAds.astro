---
interface Props {
  leftSlotId?: string;
  rightSlotId?: string;
  client?: string;
}

const {
  leftSlotId = '1234567891',
  rightSlotId = '1234567892',
  client = 'ca-pub-XXXXXXXXXXXXXXXX'
} = Astro.props;
---

<!-- Widescreen Fixed Side Rail Ads (Visible on Display >= 1536px, 160x600 Wide Skyscraper Standard) -->
<aside aria-label="사이드 스폰서 광고" class="hidden 2xl:block pointer-events-auto">
  <!-- Left Side Rail Ad (Wide Skyscraper 160x600) -->
  <div 
    class="fixed top-24 z-30 w-[160px] aspect-[160/600] transition-all duration-300 left-[max(16px,calc(50%-600px-175px))] group"
  >
    <div class="w-full h-full rounded-2xl overflow-hidden border border-indigo-500/20 bg-slate-950/95 backdrop-blur-xl shadow-2xl flex flex-col justify-between">
      <!-- Ad Header Label -->
      <div class="flex items-center justify-between px-2.5 py-1 bg-slate-950 border-b border-slate-800/80 text-[9px] text-slate-500 select-none">
        <span class="px-1.5 py-0.2 rounded bg-indigo-500/20 text-indigo-400 font-bold text-[8px]">AD</span>
        <span>광고</span>
      </div>

      <!-- Google AdSense Container & Mock Graphic -->
      <div class="p-1 flex-1 w-full h-full overflow-hidden flex flex-col items-center justify-between text-center">
        <ins
          class="adsbygoogle w-full h-full block"
          style="display:none"
          data-ad-client={client}
          data-ad-slot={leftSlotId}
          data-ad-format="vertical"
          data-full-width-responsive="false"
        ></ins>

        <a 
          href="/ai-tools"
          class="block w-full h-full overflow-hidden rounded-xl transition-all duration-300 group-hover:scale-[1.01] border border-slate-800/80 hover:border-indigo-500/50 shadow-md"
          title="스폰서 추천 광고"
        >
          <img 
            src="/images/ads/mock-siderail-saas.png" 
            alt="AI SaaS 올인원 스폰서 광고" 
            loading="lazy" 
            class="w-full h-full object-cover rounded-xl"
          />
        </a>
      </div>
    </div>
  </div>

  <!-- Right Side Rail Ad (Wide Skyscraper 160x600) -->
  <div 
    class="fixed top-24 z-30 w-[160px] aspect-[160/600] transition-all duration-300 right-[max(16px,calc(50%-600px-175px))] group"
  >
    <div class="w-full h-full rounded-2xl overflow-hidden border border-indigo-500/20 bg-slate-950/95 backdrop-blur-xl shadow-2xl flex flex-col justify-between">
      <!-- Ad Header Label -->
      <div class="flex items-center justify-between px-2.5 py-1 bg-slate-950 border-b border-slate-800/80 text-[9px] text-slate-500 select-none">
        <span class="px-1.5 py-0.2 rounded bg-purple-500/20 text-purple-400 font-bold text-[8px]">AD</span>
        <span>광고</span>
      </div>

      <!-- Google AdSense Container & Mock Graphic -->
      <div class="p-1 flex-1 w-full h-full overflow-hidden flex flex-col items-center justify-between text-center">
        <ins
          class="adsbygoogle w-full h-full block"
          style="display:none"
          data-ad-client={client}
          data-ad-slot={rightSlotId}
          data-ad-format="vertical"
          data-full-width-responsive="false"
        ></ins>

        <a 
          href="/ai-tools"
          class="block w-full h-full overflow-hidden rounded-xl transition-all duration-300 group-hover:scale-[1.01] border border-slate-800/80 hover:border-purple-500/50 shadow-md"
          title="스폰서 추천 광고"
        >
          <img 
            src="/images/ads/mock-siderail-saas.png" 
            alt="AI SaaS 올인원 스폰서 광고" 
            loading="lazy" 
            class="w-full h-full object-cover rounded-xl"
          />
        </a>
      </div>
    </div>
  </div>
</aside>
