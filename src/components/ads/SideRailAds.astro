---
interface Props {
  leftSlotId?: string;
  rightSlotId?: string;
  client?: string;
}

const {
  leftSlotId = '1234567891',
  rightSlotId = '1234567892',
  client = 'ca-pub-XXXXXXXXXXXXXXXX'
} = Astro.props;
---

<!-- Widescreen Fixed Side Rail Ads (Visible on Display >= 1536px) -->
<aside aria-label="사이드 스폰서 광고" class="hidden 2xl:block pointer-events-auto">
  <!-- Left Side Rail Ad (Wide Skyscraper 160x600) -->
  <div 
    class="fixed top-24 z-30 w-[150px] transition-all duration-300 left-[max(16px,calc(50%-600px-165px))] group"
  >
    <div class="rounded-2xl overflow-hidden border border-indigo-500/25 bg-slate-900/80 dark:bg-slate-950/90 backdrop-blur-xl shadow-2xl flex flex-col justify-between min-h-[480px]">
      <!-- Ad Header Label -->
      <div class="flex items-center justify-between px-2.5 py-1 bg-slate-950/90 border-b border-slate-800 text-[9px] text-slate-500 select-none">
        <span class="px-1 py-0.2 rounded bg-indigo-500/20 text-indigo-400 font-bold text-[8px]">AD</span>
        <span>스폰서</span>
      </div>

      <!-- Google AdSense Container -->
      <div class="p-2.5 flex-1 flex flex-col items-center justify-between text-center">
        <ins
          class="adsbygoogle w-full block"
          style="display:block"
          data-ad-client={client}
          data-ad-slot={leftSlotId}
          data-ad-format="vertical"
          data-full-width-responsive="false"
        ></ins>

        <!-- High Quality Fallback Card -->
        <div class="w-full flex-1 flex flex-col justify-between py-2 space-y-3">
          <div class="space-y-2 text-center">
            <div class="w-10 h-10 mx-auto rounded-xl bg-gradient-to-tr from-indigo-500/20 to-purple-500/20 border border-indigo-500/30 flex items-center justify-center text-xl shadow-sm">
              🌐
            </div>
            <p class="text-xs font-bold text-slate-200 dark:text-white leading-tight">
              엄선 152+ <br />
              <span class="text-indigo-400 font-extrabold">AI 사이트 모음</span>
            </p>
            <p class="text-[10px] text-slate-400 leading-tight">
              실무 생산성을 높여주는 최고의 AI 툴
            </p>
          </div>

          <div class="space-y-1.5 w-full">
            <a
              href="/ai-tools"
              class="block w-full py-1.5 px-2 rounded-lg bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 text-white text-[11px] font-bold text-center transition-all shadow-md shadow-indigo-600/20"
            >
              도구 둘러보기 &rarr;
            </a>
            <a
              href="/tools"
              class="block w-full py-1 px-2 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-slate-300 text-[10px] font-medium text-center transition-colors"
            >
              웹 유틸리티 (130+)
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Right Side Rail Ad (Wide Skyscraper 160x600) -->
  <div 
    class="fixed top-24 z-30 w-[150px] transition-all duration-300 right-[max(16px,calc(50%-600px-165px))] group"
  >
    <div class="rounded-2xl overflow-hidden border border-indigo-500/25 bg-slate-900/80 dark:bg-slate-950/90 backdrop-blur-xl shadow-2xl flex flex-col justify-between min-h-[480px]">
      <!-- Ad Header Label -->
      <div class="flex items-center justify-between px-2.5 py-1 bg-slate-950/90 border-b border-slate-800 text-[9px] text-slate-500 select-none">
        <span class="px-1 py-0.2 rounded bg-purple-500/20 text-purple-400 font-bold text-[8px]">AD</span>
        <span>스폰서</span>
      </div>

      <!-- Google AdSense Container -->
      <div class="p-2.5 flex-1 flex flex-col items-center justify-between text-center">
        <ins
          class="adsbygoogle w-full block"
          style="display:block"
          data-ad-client={client}
          data-ad-slot={rightSlotId}
          data-ad-format="vertical"
          data-full-width-responsive="false"
        ></ins>

        <!-- High Quality Fallback Card -->
        <div class="w-full flex-1 flex flex-col justify-between py-2 space-y-3">
          <div class="space-y-2 text-center">
            <div class="w-10 h-10 mx-auto rounded-xl bg-gradient-to-tr from-purple-500/20 to-pink-500/20 border border-purple-500/30 flex items-center justify-center text-xl shadow-sm">
              💬
            </div>
            <p class="text-xs font-bold text-slate-200 dark:text-white leading-tight">
              실전 370+ <br />
              <span class="text-purple-400 font-extrabold">프롬프트 & 지침</span>
            </p>
            <p class="text-[10px] text-slate-400 leading-tight">
              ChatGPT · Claude 원클릭 복사
            </p>
          </div>

          <div class="space-y-1.5 w-full">
            <a
              href="/prompts"
              class="block w-full py-1.5 px-2 rounded-lg bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 text-white text-[11px] font-bold text-center transition-all shadow-md shadow-purple-600/20"
            >
              프롬프트 복사 &rarr;
            </a>
            <a
              href="/gpts"
              class="block w-full py-1 px-2 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-slate-300 text-[10px] font-medium text-center transition-colors"
            >
              커스텀 GPTs (100)
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</aside>
