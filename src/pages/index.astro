---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const news = await getCollection('news');
const latestNews = news.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 2);

const prompts = await getCollection('prompts');
const featuredPrompts = prompts.filter(p => p.data.featured).slice(0, 3);
---

<Layout 
  title="rab8bit | AI 팁, 프롬프트 & 스마트 도구 허브" 
  description="rab8bit은 직장인과 학생을 위한 실용적인 웹 도구와 최신 AI 트렌드 및 프롬프트를 제공합니다."
>
  <div class="flex flex-col gap-16 py-4">
    {/* Hero Banner Section */}
    <section class="relative text-center py-16 px-6 rounded-3xl stitch-card overflow-hidden border border-indigo-500/30 shadow-2xl">
      {/* Background ambient lighting glow Orbs */}
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[500px] h-[500px] bg-indigo-600/25 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-32 right-10 w-96 h-96 bg-purple-600/25 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl mx-auto space-y-6">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full stitch-pill text-xs sm:text-sm font-bold shadow-inner">
          <span class="animate-pulse text-amber-400">✨</span> Google Stitch UI 엔진으로 설계된 2026 AI 허브
        </div>

        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white leading-[1.15]">
          생산성의 한계를 넘다 <br class="hidden sm:inline" />
          스마트 플랫폼 <span class="gradient-text-stitch">rab8bit</span>
        </h1>

        <p class="text-base sm:text-xl text-slate-300 max-w-2xl mx-auto font-normal leading-relaxed">
          실시간 단위 변환기부터 사다리 타기, 최신 AI 트렌드 및 원클릭 검증 프롬프트 라이브러리까지.
        </p>

        <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
          <a
            href="/ai-tools"
            class="px-6 py-3.5 rounded-2xl bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 hover:from-indigo-400 hover:to-pink-400 text-white font-bold text-sm shadow-lg shadow-purple-500/30 transition-all hover:scale-105 active:scale-95 flex items-center gap-2"
          >
            <span>🤖 추천 AI 사이트 (152종)</span>
          </a>
          <a
            href="/tools"
            class="px-6 py-3.5 rounded-2xl bg-slate-900/90 text-slate-200 font-bold text-sm border border-indigo-500/30 shadow-md hover:bg-slate-800 transition-all hover:scale-105 active:scale-95 flex items-center gap-2"
          >
            <span>🛠️ 29종 스마트 도구</span>
          </a>
          <a
            href="/prompts"
            class="px-6 py-3.5 rounded-2xl bg-slate-900/90 text-slate-200 font-bold text-sm border border-indigo-500/30 shadow-md hover:bg-slate-800 transition-all hover:scale-105 active:scale-95 flex items-center gap-2"
          >
            <span>💡 프롬프트 모음</span>
          </a>
        </div>
      </div>
    </section>

    {/* Web Tools Section */}
    <section class="space-y-6">
      <div class="flex items-end justify-between border-b border-indigo-500/20 pb-4">
        <div>
          <span class="text-xs font-bold text-indigo-400 tracking-wider uppercase">29 Utilities</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">🛠️ 스마트 유틸리티 도구</h2>
        </div>
        <a href="/tools" class="text-xs sm:text-sm font-bold text-indigo-400 hover:text-indigo-300 flex items-center gap-1">
          전체 29종 도구 보기 &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {/* Tool 1: Unit Converter */}
        <a
          href="/tools/unit-converter"
          class="group relative stitch-card p-8 rounded-3xl overflow-hidden flex flex-col justify-between"
        >
          <div class="absolute top-0 right-0 w-36 h-36 bg-indigo-500/10 rounded-bl-full group-hover:scale-110 transition-transform"></div>

          <div class="space-y-4 relative z-10">
            <div class="w-14 h-14 rounded-2xl bg-indigo-950/80 border border-indigo-500/30 flex items-center justify-center text-3xl shadow-inner">
              📐
            </div>
            <div>
              <h3 class="text-2xl font-bold text-white group-hover:text-indigo-400 transition-colors">
                실시간 단위 변환기
              </h3>
              <p class="text-sm text-slate-400 mt-2 leading-relaxed">
                평수(㎡), 무게(kg/lb), 길이(cm/inch) 등 일상 및 업무 필수 단위를 실시간으로 즉시 변환합니다.
              </p>
            </div>
          </div>

          <div class="mt-8 pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs font-bold text-indigo-400">
            <span>평수 · 무게 · 길이 지원</span>
            <span class="group-hover:translate-x-1.5 transition-transform flex items-center gap-1">
              변환기 실행 &rarr;
            </span>
          </div>
        </a>

        {/* Tool 2: Ladder Game */}
        <a
          href="/tools/ladder-game"
          class="group relative stitch-card p-8 rounded-3xl overflow-hidden flex flex-col justify-between"
        >
          <div class="absolute top-0 right-0 w-36 h-36 bg-purple-500/10 rounded-bl-full group-hover:scale-110 transition-transform"></div>

          <div class="space-y-4 relative z-10">
            <div class="w-14 h-14 rounded-2xl bg-purple-950/80 border border-purple-500/30 flex items-center justify-center text-3xl shadow-inner">
              🪜
            </div>
            <div>
              <h3 class="text-2xl font-bold text-white group-hover:text-purple-400 transition-colors">
                랜덤 사다리 타기
              </h3>
              <p class="text-sm text-slate-400 mt-2 leading-relaxed">
                점심 내기, 벌칙 정하기! SVG 라인 연출과 URL 결과 공유 기능을 지원하는 사다리 게임.
              </p>
            </div>
          </div>

          <div class="mt-8 pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs font-bold text-purple-400">
            <span>2~12명 · 결과 URL 공유</span>
            <span class="group-hover:translate-x-1.5 transition-transform flex items-center gap-1">
              게임 시작 &rarr;
            </span>
          </div>
        </a>
      </div>
    </section>

    {/* AI Prompts Section */}
    <section class="space-y-6">
      <div class="flex items-end justify-between border-b border-indigo-500/20 pb-4">
        <div>
          <span class="text-xs font-bold text-purple-400 tracking-wider uppercase">Prompts Library</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">💡 검증된 AI 프롬프트</h2>
        </div>
        <a href="/prompts" class="text-xs sm:text-sm font-bold text-purple-400 hover:underline">
          전체 보기 &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {featuredPrompts.map((item) => (
          <a
            href={`/prompts/${item.id}`}
            class="group stitch-card p-6 rounded-2xl flex flex-col justify-between"
          >
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="px-3 py-1 bg-purple-950/80 text-purple-300 text-xs font-semibold rounded-full border border-purple-800/50">
                  {item.data.category}
                </span>
                {item.data.featured && (
                  <span class="text-[10px] font-bold px-2 py-0.5 bg-amber-900/60 text-amber-300 rounded border border-amber-700/50">
                    HOT
                  </span>
                )}
              </div>

              <h3 class="text-lg font-bold text-white group-hover:text-purple-400 transition-colors">
                {item.data.title}
              </h3>

              <p class="text-xs text-slate-400 line-clamp-3 leading-relaxed">
                {item.data.description}
              </p>
            </div>

            <div class="mt-6 pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs text-purple-400 font-bold">
              <span>원클릭 복사</span>
              <span class="group-hover:translate-x-1 transition-transform">
                자세히 보기 &rarr;
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>

    {/* AI News Section */}
    <section class="space-y-6">
      <div class="flex items-end justify-between border-b border-indigo-500/20 pb-4">
        <div>
          <span class="text-xs font-bold text-indigo-400 tracking-wider uppercase">Editorial</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">📰 최신 AI 뉴스 & 실무 팁</h2>
        </div>
        <a href="/news" class="text-xs sm:text-sm font-bold text-indigo-400 hover:underline">
          전체 보기 &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {latestNews.map((post) => (
          <a
            href={`/news/${post.id}`}
            class="group stitch-card p-6 rounded-2xl flex flex-col justify-between"
          >
            <div class="space-y-3">
              <span class="inline-block px-3 py-1 bg-indigo-950/80 text-indigo-300 text-xs font-semibold rounded-full border border-indigo-800/50">
                {post.data.category}
              </span>
              <h3 class="text-xl font-bold text-white group-hover:text-indigo-400 transition-colors">
                {post.data.title}
              </h3>
              <p class="text-xs sm:text-sm text-slate-400 line-clamp-2 leading-relaxed">
                {post.data.description}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-800/80 flex justify-between items-center text-xs text-slate-400">
              <span>{post.data.pubDate.toISOString().split('T')[0]}</span>
              <span class="text-indigo-400 font-bold group-hover:translate-x-1 transition-transform">
                아티클 읽기 &rarr;
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>
