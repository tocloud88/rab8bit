---
import Layout from '../layouts/Layout.astro';
import { BLOGS_DATA } from '../data/blogsData';
import { INSIGHTS_DATA } from '../data/insightsData';
import { PROMPTS_DATA } from '../data/promptsData';
import { GPTS_DATA } from '../data/gptsData';
import { GALLERY_DATA } from '../data/galleryData';
import { EBOOKS_DATA } from '../data/ebooksData';
import { INTERACTIVE_TOOLS } from '../components/tools/ToolsDirectory';

const latestBlogs = BLOGS_DATA.slice(0, 4);
const featuredInsights = INSIGHTS_DATA.slice(0, 4);
const featuredPrompts = PROMPTS_DATA.slice(0, 4);
const featuredTools = INTERACTIVE_TOOLS.slice(0, 4);
const featuredGallery = GALLERY_DATA.slice(0, 4);
const featuredEbooks = EBOOKS_DATA.slice(0, 4);
---

<Layout 
  title="rab8bit | AI 인사이트, 프롬프트, 도구 & 갤러리 올인원 플랫폼" 
  description="최신 AI 블로그, 90+ 영상 인사이트, 370+ 프롬프트·GPTs 지침, 150+ 추천 AI 사이트, 130+ 스마트 웹 도구를 제공하는 종합 포털입니다."
>
  <div class="flex flex-col gap-14 py-2">
    {/* Hero Banner Section */}
    <section class="relative text-center py-14 px-6 rounded-3xl stitch-card overflow-hidden border border-indigo-500/30 shadow-2xl">
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[500px] h-[500px] bg-indigo-600/25 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-32 right-10 w-96 h-96 bg-purple-600/25 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-4xl mx-auto space-y-6">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full stitch-pill text-xs sm:text-sm font-bold shadow-inner">
          <span class="animate-pulse text-amber-400">✨</span> 2026 AI 인사이트 & 스마트 도구 올인원 플랫폼
        </div>

        <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white leading-[1.15]">
          AI와 생산성의 모든 것 <br class="hidden sm:inline" />
          <span class="gradient-text-stitch">rab8bit 포털</span>
        </h1>

        <p class="text-sm sm:text-lg text-slate-300 max-w-2xl mx-auto font-normal leading-relaxed">
          56편의 AI 심층 아티클, 94편의 실무 인사이트, 370+ 검증된 프롬프트와 130+ 스마트 도구를 한곳에서 만나보세요.
        </p>

        {/* Quick Category Navigation Pills */}
        <div class="pt-2 flex flex-wrap items-center justify-center gap-2.5 max-w-3xl mx-auto">
          <a
            href="/blog"
            class="px-3.5 py-2 rounded-xl bg-slate-900/90 hover:bg-indigo-600 text-slate-200 hover:text-white font-bold text-xs border border-indigo-500/30 transition-all hover:scale-105"
          >
            📝 블로그 (56)
          </a>
          <a
            href="/insights"
            class="px-3.5 py-2 rounded-xl bg-slate-900/90 hover:bg-indigo-600 text-slate-200 hover:text-white font-bold text-xs border border-indigo-500/30 transition-all hover:scale-105"
          >
            🎬 인사이트 (94)
          </a>
          <a
            href="/tools"
            class="px-3.5 py-2 rounded-xl bg-slate-900/90 hover:bg-indigo-600 text-slate-200 hover:text-white font-bold text-xs border border-indigo-500/30 transition-all hover:scale-105"
          >
            🛠️ 웹 도구 (130+)
          </a>
          <a
            href="/prompts"
            class="px-3.5 py-2 rounded-xl bg-gradient-to-r from-indigo-500 to-purple-500 text-white font-bold text-xs shadow-md shadow-indigo-500/25 transition-all hover:scale-105"
          >
            💬 프롬프트 (274)
          </a>
          <a
            href="/gpts"
            class="px-3.5 py-2 rounded-xl bg-gradient-to-r from-purple-500 to-pink-500 text-white font-bold text-xs shadow-md shadow-purple-500/25 transition-all hover:scale-105"
          >
            🤖 챗봇지침 (100)
          </a>
          <a
            href="/gallery"
            class="px-3.5 py-2 rounded-xl bg-yellow-500/15 hover:bg-yellow-500 text-yellow-300 hover:text-slate-950 font-bold text-xs border border-yellow-500/30 transition-all hover:scale-105"
          >
            🍌 바나나 갤러리 (33)
          </a>
          <a
            href="/ai-tools"
            class="px-3.5 py-2 rounded-xl bg-slate-900/90 hover:bg-indigo-600 text-slate-200 hover:text-white font-bold text-xs border border-indigo-500/30 transition-all hover:scale-105"
          >
            🌐 추천 AI (152)
          </a>
          <a
            href="/ebooks"
            class="px-3.5 py-2 rounded-xl bg-emerald-500/15 hover:bg-emerald-500 text-emerald-300 hover:text-slate-950 font-bold text-xs border border-emerald-500/30 transition-all hover:scale-105"
          >
            📚 전자책 (14)
          </a>
        </div>
      </div>
    </section>

    {/* 1. AI Blog Latest Section (4 cols Web, 2 cols Mobile) */}
    <section class="space-y-4">
      <div class="flex items-end justify-between border-b border-indigo-500/20 pb-3">
        <div>
          <span class="text-xs font-bold text-indigo-400 tracking-wider uppercase">Editorial</span>
          <h2 class="text-xl sm:text-2xl font-extrabold text-white">📰 최신 AI 블로그 & 인사이트</h2>
        </div>
        <a href="/blog" class="text-xs sm:text-sm font-bold text-indigo-400 hover:underline">
          전체 54편 보기 &rarr;
        </a>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3.5 sm:gap-5">
        {latestBlogs.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="stitch-card rounded-2xl overflow-hidden flex flex-col justify-between group hover:border-indigo-500/50 transition-all hover:-translate-y-1"
          >
            <div class="relative aspect-[16/10] w-full overflow-hidden bg-slate-950">
              {post.thumbnail ? (
                <img
                  src={post.thumbnail}
                  alt={post.title}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center bg-indigo-950/40 text-indigo-400 text-2xl">
                  📝
                </div>
              )}
            </div>
            <div class="p-3.5 sm:p-4 flex-1 flex flex-col justify-between space-y-2">
              <div>
                <span class="text-[10px] text-slate-500">{post.date}</span>
                <h3 class="font-bold text-xs sm:text-sm text-white group-hover:text-indigo-400 transition-colors line-clamp-2 leading-snug">
                  {post.title}
                </h3>
              </div>
              <span class="text-[11px] text-indigo-400 font-bold pt-2 border-t border-slate-800">
                읽기 &rarr;
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>

    {/* 2. AI Video Insights Section (4 cols Web, 2 cols Mobile) */}
    <section class="space-y-4">
      <div class="flex items-end justify-between border-b border-indigo-500/20 pb-3">
        <div>
          <span class="text-xs font-bold text-indigo-400 tracking-wider uppercase">Video & Guides</span>
          <h2 class="text-xl sm:text-2xl font-extrabold text-white">🎬 AI 실무 영상 & 인사이트</h2>
        </div>
        <a href="/insights" class="text-xs sm:text-sm font-bold text-indigo-400 hover:underline">
          전체 91편 보기 &rarr;
        </a>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3.5 sm:gap-5">
        {featuredInsights.map((item) => (
          <div class="stitch-card rounded-2xl overflow-hidden flex flex-col justify-between group hover:border-indigo-500/50 transition-all hover:-translate-y-1">
            <div class="relative aspect-video w-full overflow-hidden bg-slate-950">
              {item.thumbnail ? (
                <img
                  src={item.thumbnail}
                  alt={item.title}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center bg-indigo-950/40 text-indigo-400 text-2xl">
                  🎬
                </div>
              )}
              {item.category && (
                <span class="absolute bottom-2 left-2 px-2 py-0.5 text-[10px] font-semibold rounded bg-slate-950/80 text-indigo-300">
                  {item.category}
                </span>
              )}
            </div>
            <div class="p-3.5 sm:p-4 flex-1 flex flex-col justify-between space-y-2">
              <h3 class="font-bold text-xs sm:text-sm text-white group-hover:text-indigo-400 transition-colors line-clamp-2 leading-snug">
                {item.title}
              </h3>
              <div class="pt-2 border-t border-slate-800 flex items-center justify-between">
                <a href="/insights" class="text-[11px] text-indigo-400 font-bold hover:underline">
                  요약보기 &rarr;
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* 3. Smart Utilities & Tools Section (4 cols Web, 2 cols Mobile) */}
    <section class="space-y-4">
      <div class="flex items-end justify-between border-b border-indigo-500/20 pb-3">
        <div>
          <span class="text-xs font-bold text-indigo-400 tracking-wider uppercase">Utilities</span>
          <h2 class="text-xl sm:text-2xl font-extrabold text-white">🛠️ 인기 스마트 유틸리티 도구</h2>
        </div>
        <a href="/tools" class="text-xs sm:text-sm font-bold text-indigo-400 hover:underline">
          전체 130+ 도구 보기 &rarr;
        </a>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3.5 sm:gap-5">
        {featuredTools.map((tool) => (
          <a
            href={`/tools/${tool.slug}`}
            class="stitch-card p-3.5 sm:p-5 rounded-2xl flex flex-col justify-between group hover:border-indigo-500/50 transition-all hover:-translate-y-1"
          >
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-2xl p-2 rounded-xl bg-indigo-950/50 border border-indigo-800/30">
                  {tool.icon}
                </span>
                {tool.badge && (
                  <span class="text-[10px] px-2 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300 font-bold">
                    {tool.badge}
                  </span>
                )}
              </div>
              <h3 class="font-bold text-xs sm:text-sm text-white group-hover:text-indigo-400 transition-colors line-clamp-1">
                {tool.title}
              </h3>
              <p class="text-[11px] text-slate-400 line-clamp-2">
                {tool.description}
              </p>
            </div>
            <div class="mt-3 pt-2 border-t border-slate-800 flex items-center justify-between text-[11px] text-indigo-400 font-bold">
              <span>웹 앱 실행</span>
              <span class="group-hover:translate-x-1 transition-transform">실행 &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    {/* 4. AI Prompts Showcase Section (4 cols Web, 2 cols Mobile) */}
    <section class="space-y-4">
      <div class="flex items-end justify-between border-b border-indigo-500/20 pb-3">
        <div>
          <span class="text-xs font-bold text-purple-400 tracking-wider uppercase">Prompts</span>
          <h2 class="text-xl sm:text-2xl font-extrabold text-white">💬 실전 AI 프롬프트 라이브러리</h2>
        </div>
        <a href="/prompts" class="text-xs sm:text-sm font-bold text-purple-400 hover:underline">
          전체 370+ 프롬프트 & GPTs 보기 &rarr;
        </a>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3.5 sm:gap-5">
        {featuredPrompts.map((p) => (
          <div class="stitch-card p-3.5 sm:p-5 rounded-2xl flex flex-col justify-between group hover:border-purple-500/50 transition-all hover:-translate-y-1">
            <div class="space-y-2">
              <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-purple-950 text-purple-300 border border-purple-800/50">
                {p.category_name || '프롬프트'}
              </span>
              <h3 class="font-bold text-xs sm:text-sm text-white group-hover:text-purple-400 transition-colors line-clamp-2 leading-snug">
                {p.title}
              </h3>
              <p class="text-[11px] text-slate-400 line-clamp-2">
                {p.description}
              </p>
            </div>
            <div class="mt-3 pt-2 border-t border-slate-800 flex items-center justify-between text-[11px] text-purple-400 font-bold">
              <a href="/prompts" class="w-full text-center py-1.5 rounded-lg bg-purple-600/20 hover:bg-purple-600 text-purple-300 hover:text-white transition-colors">
                프롬프트 복사 &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* 5. Banana AI Gallery Showcase (4 cols Web, 2 cols Mobile) */}
    <section class="space-y-4">
      <div class="flex items-end justify-between border-b border-indigo-500/20 pb-3">
        <div>
          <span class="text-xs font-bold text-yellow-400 tracking-wider uppercase">Gallery</span>
          <h2 class="text-xl sm:text-2xl font-extrabold text-white">🍌 바나나 AI 갤러리</h2>
        </div>
        <a href="/gallery" class="text-xs sm:text-sm font-bold text-yellow-400 hover:underline">
          전체 33작품 보기 &rarr;
        </a>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3.5 sm:gap-5">
        {featuredGallery.map((img) => (
          <a
            href="/gallery"
            class="stitch-card rounded-2xl overflow-hidden flex flex-col justify-between group hover:border-yellow-500/50 transition-all hover:-translate-y-1"
          >
            <div class="relative aspect-square w-full overflow-hidden bg-slate-950">
              <img
                src={img.image_url}
                alt={img.title}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-3.5 flex-1 flex flex-col justify-between">
              <h3 class="font-bold text-xs sm:text-sm text-white group-hover:text-yellow-400 transition-colors line-clamp-1">
                {img.title}
              </h3>
              <span class="text-[11px] text-yellow-400 font-semibold pt-2 border-t border-slate-800">
                프롬프트 확인 &rarr;
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>

    {/* 6. AI Ebooks & Guides Showcase (4 cols Web, 2 cols Mobile) */}
    <section class="space-y-4">
      <div class="flex items-end justify-between border-b border-indigo-500/20 pb-3">
        <div>
          <span class="text-xs font-bold text-emerald-400 tracking-wider uppercase">E-Books</span>
          <h2 class="text-xl sm:text-2xl font-extrabold text-white">📚 AI 전문 가이드 & 전자책</h2>
        </div>
        <a href="/ebooks" class="text-xs sm:text-sm font-bold text-emerald-400 hover:underline">
          전체 14종 전자책 보기 &rarr;
        </a>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3.5 sm:gap-5">
        {featuredEbooks.map((eb) => (
          <div class="stitch-card rounded-2xl overflow-hidden flex flex-col justify-between group hover:border-emerald-500/50 transition-all hover:-translate-y-1">
            <div class="relative aspect-[3/4] w-full overflow-hidden bg-slate-950">
              {eb.thumbnail ? (
                <img
                  src={eb.thumbnail}
                  alt={eb.title}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center bg-emerald-950/40 text-emerald-400 text-3xl">
                  📚
                </div>
              )}
            </div>
            <div class="p-3.5 flex-1 flex flex-col justify-between space-y-2">
              <h3 class="font-bold text-xs sm:text-sm text-white group-hover:text-emerald-400 transition-colors line-clamp-1">
                {eb.title}
              </h3>
              <div class="pt-2 border-t border-slate-800">
                <a
                  href={eb.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full block text-center py-1.5 rounded-lg bg-emerald-500/10 hover:bg-emerald-500 text-emerald-300 hover:text-slate-950 text-xs font-bold transition-all border border-emerald-500/30"
                >
                  가이드 열기 &rarr;
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
