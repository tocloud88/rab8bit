---
import Layout from '../layouts/Layout.astro';
import GlobalSearch from '../components/search/GlobalSearch';
import AdBanner from '../components/ads/AdBanner.astro';
---

<Layout
  title="통합 검색 - rab8bit"
  description="rab8bit의 모든 블로그 아티클, AI 인사이트, 스마트 도구, 프롬프트 및 추천 AI 사이트를 한 번에 검색하세요."
>
  <div class="container mx-auto px-4 py-8 max-w-5xl space-y-8">
    {/* Header */}
    <div class="text-center space-y-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-bold">
        <span>🔍</span> 올인원 통합 검색
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        rab8bit <span class="gradient-text-stitch">통합 검색</span>
      </h1>
    </div>

    {/* Search Interface */}
    <GlobalSearch client:load />

    {/* Bottom Horizontal Ad Slot */}
    <AdBanner type="horizontal" className="mt-8" />
  </div>
</Layout>

