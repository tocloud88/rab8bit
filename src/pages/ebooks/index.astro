---
import Layout from '../../layouts/Layout.astro';
import EbooksDirectory from '../../components/ebooks/EbooksDirectory';
---

<Layout
  title="AI 전자책 & 실전 가이드북 - rab8bit"
  description="AI 실무, 프롬프트 엔지니어링, 바이브 코딩, 수익화 전략을 체계적으로 정리한 전자책 및 PDF 가이드 모음입니다."
>
  <div class="container mx-auto px-4 py-8 space-y-8">
    {/* Page Header */}
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-bold">
        <span>📚</span> AI 전문 가이드북 & 전자책
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        AI 전자책 <span class="gradient-text-stitch">라이브러리</span>
      </h1>
      <p class="text-sm sm:text-base text-slate-400">
        AI 도구 활용법부터 바이브 코딩 및 실전 프롬프트 노하우까지 한눈에 마스터하는 전자책 모음입니다.
      </p>
    </div>

    {/* Interactive Ebooks Directory */}
    <EbooksDirectory client:load />
  </div>
</Layout>
