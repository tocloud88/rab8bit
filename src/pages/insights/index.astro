---
import Layout from '../../layouts/Layout.astro';
import AdBanner from '../../components/ads/AdBanner.astro';
import InsightsDirectory from '../../components/insights/InsightsDirectory';
---

<Layout
  title="AI 인사이트 & 실무 팁 - rab8bit"
  description="최신 AI 트렌드, 제미나이 튜토리얼, 바이브 코딩 및 실무 영상 가이드와 핵심 자료를 무료로 확인하세요."
>
  <div class="w-full space-y-8">
    {/* Page Header */}
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-bold">
        <span>🎬</span> 실무 영상 & 인사이트 라이브러리
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        AI 인사이트 <span class="gradient-text-stitch">아카이브</span>
      </h1>
      <p class="text-sm sm:text-base text-slate-400">
        유튜브 실무 튜토리얼 영상과 연동된 핵심 자료, 실전 프롬프트 및 다운로드 링크를 제공합니다.
      </p>
    </div>

    {/* Top Ad Slot */}
    <AdBanner type="leaderboard" label="인사이트 추천 & 스폰서" />

    {/* Interactive Directory */}
    <InsightsDirectory client:load />
  </div>
</Layout>
