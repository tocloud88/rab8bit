---
import Layout from '../../layouts/Layout.astro';
import LottoGenerator from '../../components/tools/LottoGenerator';
---

<Layout 
  title="로또 6/45 번호 생성기 | 제외수·고정수 필터 & 행운 번호 추첨 - rab8bit"
  description="로또 6/45 행운의 번호 자동 생성기. 고정수 지정 및 제외수 필터링, 공식 번호대별 색상 시각화 및 원클릭 번호 복사 기능을 제공합니다."
>
  <div class="max-w-4xl mx-auto space-y-8">
    <div class="text-center space-y-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full stitch-pill text-xs font-bold">
        🍀 행운 추첨기
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white">로또 6/45 번호 생성기</h1>
      <p class="text-slate-400 text-sm sm:text-base">
        원하는 고정수와 제외수를 설정하고 공정하고 정교한 난수 알고리즘으로 행운의 조합을 생성하세요.
      </p>
    </div>

    <LottoGenerator client:load />

    <div class="mt-12 stitch-card p-6 rounded-3xl border border-indigo-500/20 space-y-3 text-sm text-slate-300">
      <h2 class="text-lg font-bold text-white">🎱 로또 공식 공 색상 안내</h2>
      <div className="flex flex-wrap gap-2 text-xs pt-1">
        <span class="px-2.5 py-1 rounded-lg bg-amber-500/20 text-amber-300 border border-amber-500/30">1~10번: 노란색</span>
        <span class="px-2.5 py-1 rounded-lg bg-blue-500/20 text-blue-300 border border-blue-500/30">11~20번: 파란색</span>
        <span class="px-2.5 py-1 rounded-lg bg-red-500/20 text-red-300 border border-red-500/30">21~30번: 빨간색</span>
        <span class="px-2.5 py-1 rounded-lg bg-slate-500/20 text-slate-300 border border-slate-500/30">31~40번: 회색</span>
        <span class="px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">41~45번: 녹색</span>
      </div>
    </div>
  </div>
</Layout>
