---
import Layout from '../../layouts/Layout.astro';
import AdBanner from '../../components/ads/AdBanner.astro';
import WaterIntakeCalculator from '../../components/tools/WaterIntakeCalculator';
---

<Layout 
  title="하루 권장 물 섭취량 계산기 | rab8bit 스마트 툴스" 
  description="체중과 일일 활동량, 날씨를 고려하여 하루에 마셔야 할 최적의 음수량(mL)과 시간대별 가이드를 제공합니다."
>
  <div class="space-y-8 max-w-4xl mx-auto py-4">
    <div class="flex items-center gap-2 text-xs text-slate-400">
      <a href="/" class="hover:text-white transition-colors">홈</a>
      <span>&gt;</span>
      <a href="/tools" class="hover:text-white transition-colors">스마트 도구</a>
      <span>&gt;</span>
      <span class="text-indigo-400 font-semibold">하루 권장 물 섭취량 계산기</span>
    </div>

    <div class="text-center space-y-3">
      <div class="inline-flex items-center gap-2 px-4 py-1 rounded-full stitch-pill text-xs font-bold">
        <span>💧</span> <span>건강습관</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
        하루 권장 물 섭취량 계산기
      </h1>
      <p class="text-slate-400 max-w-xl mx-auto text-xs sm:text-sm leading-relaxed">
        체중과 일일 활동량, 날씨를 고려하여 하루에 마셔야 할 최적의 음수량(mL)과 시간대별 가이드를 제공합니다.
      </p>
    </div>

    <AdBanner type="leaderboard" label="스마트 비즈니스 &amp; 생산성 스폰서" />

    <WaterIntakeCalculator client:load />

    <AdBanner type="horizontal" className="my-8" />
  </div>
</Layout>
