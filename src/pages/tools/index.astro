---
import Layout from '../../layouts/Layout.astro';
import AdBanner from '../../components/ads/AdBanner.astro';
import ToolsDirectory from '../../components/tools/ToolsDirectory';
---

<Layout 
  title="스마트 도구 모음 (29종) | 무료 온라인 웹 유틸리티 허브 - rab8bit" 
  description="회원가입 없이 브라우저에서 바로 쓰는 무료 온라인 도구 모음. 단위변환기, 사다리타기, 나이계산기, 룰렛, QR코드, JWT 디코더, 글자수세기 등 29종의 스마트 도구를 제공합니다."
>
  <div class="space-y-10 max-w-6xl mx-auto py-4">
    <!-- Header Hero -->
    <div class="text-center space-y-3">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full stitch-pill text-xs font-bold">
        🛠️ 29종 무료 스마트 웹 유틸리티 허브
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        일상과 업무를 스마트하게, <span class="gradient-text-stitch">rab8bit 툴스</span>
      </h1>
      <p class="text-slate-400 max-w-2xl mx-auto text-sm sm:text-base leading-relaxed">
        설치나 회원가입 없이 브라우저에서 안전하게 실행되는 계산기, 텍스트 도구, 랜덤 게임, 개발자 유틸리티를 자유롭게 사용하세요.
      </p>
    </div>

    <!-- Ad Slot -->
    <AdBanner type="leaderboard" label="스마트 비즈니스 & 생산성 유틸리티 스폰서" />

    <!-- Interactive Tools Directory Component -->
    <ToolsDirectory client:load />
  </div>
</Layout>
