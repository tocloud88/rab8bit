---
import Layout from '../../layouts/Layout.astro';
import BirthdaySecret from '../../components/tools/BirthdaySecret';
---

<Layout 
  title="나의 탄생 비밀 | 탄생화·탄생석·탄생목·탄생색 조회 - rab8bit"
  description="생일만 입력하면 나의 탄생화(꽃말), 탄생석(보석말), 탄생목(나무 상징), 탄생색(힐링 컬러)을 한눈에 확인할 수 있는 생일 백과사전입니다."
>
  <div class="max-w-4xl mx-auto space-y-8">
    <div class="text-center space-y-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full stitch-pill text-xs font-bold">
        💎 생일 백과사전
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white">나의 탄생 비밀</h1>
      <p class="text-slate-400 text-sm sm:text-base">
        내가 태어난 날의 탄생석, 탄생화, 탄생목과 고유 탄생색의 의미를 알아보세요.
      </p>
    </div>

    <BirthdaySecret client:load />
  </div>
</Layout>
