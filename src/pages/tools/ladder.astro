---
import Layout from '../../layouts/Layout.astro';
import LadderGame from '../../components/tools/LadderGame';
---

<Layout 
  title="사다리 타기 | 공정한 랜덤 결과 추첨 게임 - rab8bit" 
  description="2인부터 12인까지 참여 가능한 실시간 온라인 사다리 타기 게임. 점심 메뉴 고르기, 커피 내기, 벌칙 정하기에 활용하세요."
>
  <div class="max-w-4xl mx-auto space-y-8">
    <div class="text-center space-y-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full stitch-pill text-xs font-bold">
        🪜 랜덤 추첨 도구
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white">사다리 타기</h1>
      <p class="text-slate-400 text-sm sm:text-base">
        참가자와 당첨/벌칙 항목을 입력하고 사다리를 타서 공정하게 결과를 정하세요.
      </p>
    </div>

    <LadderGame client:load />
  </div>
</Layout>
