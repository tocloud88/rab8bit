---
import Layout from '../../layouts/Layout.astro';
import AdBanner from '../../components/ads/AdBanner.astro';
import { BLOGS_DATA, type BlogPost } from '../../data/blogsData';

export async function getStaticPaths() {
  return BLOGS_DATA.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

// Related posts
const relatedPosts = BLOGS_DATA.filter((p) => p.id !== post.id).slice(0, 4);
---

<Layout
  title={`${post.title} | rab8bit AI 블로그`}
  description={post.excerpt}
>
  <div class="max-w-4xl mx-auto space-y-8">
    {/* Navigation Breadcrumb */}
    <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
      <a href="/" class="hover:text-indigo-600 dark:hover:text-white">홈</a>
      <span>/</span>
      <a href="/blog" class="hover:text-indigo-600 dark:hover:text-white">블로그</a>
      <span>/</span>
      <span class="text-indigo-600 dark:text-indigo-400 truncate max-w-xs">{post.title}</span>
    </div>

    {/* Post Header */}
    <div class="space-y-4 border-b border-indigo-500/20 pb-6">
      <div class="flex flex-wrap items-center gap-2">
        <span class="px-3 py-1 rounded-full bg-indigo-50 dark:bg-indigo-950/80 text-indigo-700 dark:text-indigo-300 text-xs font-bold border border-indigo-200 dark:border-indigo-800/50">
          AI 아티클
        </span>
        <span class="text-xs text-slate-400 dark:text-slate-500">•</span>
        <span class="text-xs text-slate-600 dark:text-slate-400">{post.date}</span>
        <span class="text-xs text-slate-400 dark:text-slate-500">•</span>
        <span class="text-xs text-slate-600 dark:text-slate-400 font-medium">작성자: {post.author}</span>
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 dark:text-white leading-tight tracking-tight">
        {post.title}
      </h1>

      <p class="text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-relaxed bg-indigo-50/70 dark:bg-slate-900/50 p-4 sm:p-5 rounded-2xl border border-indigo-200/80 dark:border-indigo-500/20">
        💡 {post.excerpt}
      </p>

      {/* Tags */}
      {post.tags && post.tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 pt-2">
          {post.tags.map((tag) => (
            <a
              href={`/blog`}
              class="text-xs px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800/80 text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-300 hover:bg-slate-200 dark:hover:bg-slate-700/80 transition-colors border border-slate-200 dark:border-slate-700/50"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}
    </div>

    {/* Featured Thumbnail if present */}
    {post.thumbnail && (
      <div class="flex justify-center w-full my-2">
        <div class="w-full max-w-[800px] rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800 shadow-lg dark:shadow-2xl bg-white dark:bg-slate-950 flex items-center justify-center">
          <img
            src={post.thumbnail}
            alt={post.title}
            class="w-full h-auto max-h-[460px] object-cover object-center"
            loading="eager"
          />
        </div>
      </div>
    )}

    {/* Rich HTML Content Body with Tailwind Typography */}
    <article class="prose prose-slate dark:prose-invert prose-indigo max-w-none prose-headings:font-bold prose-headings:text-slate-900 dark:prose-headings:text-white prose-p:text-slate-700 dark:prose-p:text-slate-300 prose-p:leading-relaxed prose-a:text-indigo-600 dark:prose-a:text-indigo-400 prose-a:no-underline hover:prose-a:underline prose-code:text-indigo-600 dark:prose-code:text-indigo-300 prose-code:bg-slate-100 dark:prose-code:bg-slate-900 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-img:rounded-2xl prose-img:border prose-img:border-slate-200 dark:prose-img:border-slate-800 space-y-4">
      <div class="blog-content bg-white dark:bg-slate-900/40 p-5 sm:p-10 rounded-3xl border border-slate-200 dark:border-slate-800/80 shadow-sm dark:shadow-none leading-relaxed text-slate-800 dark:text-slate-200" set:html={post.content} />
    </article>

    {/* In-Article Bottom Ad Slot */}
    <AdBanner type="in-article" label="추천 AI 도구 & 실무 솔루션" />

    {/* Back to Blog List CTA */}
    <div class="pt-6 border-t border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
      <a
        href="/blog"
        class="px-5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 hover:text-slate-900 dark:hover:text-white text-xs sm:text-sm font-bold transition-all flex items-center gap-2 border border-slate-300 dark:border-slate-700"
      >
        <span>&larr;</span> 목록으로 돌아가기
      </a>
      <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
        <span>더 많은 실무 팁 확인:</span>
        <a href="/insights" class="text-indigo-600 dark:text-indigo-400 font-bold hover:underline">인사이트 보기 &rarr;</a>
      </div>
    </div>

    {/* Related Posts Section (4 cols Web, 2 cols Mobile) */}
    <div class="space-y-4 pt-8">
      <h2 class="text-xl font-bold text-white flex items-center gap-2">
        <span>📚</span> 다른 인기 아티클
      </h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3.5 sm:gap-4">
        {relatedPosts.map((rel) => (
          <a
            href={`/blog/${rel.id}`}
            class="stitch-card p-3.5 rounded-2xl flex flex-col justify-between group hover:border-indigo-500/50 transition-all hover:-translate-y-1"
          >
            <div class="space-y-1.5">
              <span class="text-[10px] text-slate-500">{rel.date}</span>
              <h3 class="font-bold text-xs text-white group-hover:text-indigo-400 transition-colors line-clamp-2 leading-snug">
                {rel.title}
              </h3>
            </div>
            <span class="text-[11px] text-indigo-400 font-semibold mt-3 pt-2 border-t border-slate-800 group-hover:translate-x-1 transition-transform">
              읽기 &rarr;
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  /* ==========================================================================
     Blog Content High-Contrast & Premium Readability Engine
     ========================================================================== */

  /* 1. DARK MODE BASE TYPOGRAPHY */
  html.dark .blog-content {
    color: #e2e8f0 !important;
  }
  html.dark .blog-content p,
  html.dark .blog-content li,
  html.dark .blog-content span,
  html.dark .blog-content td {
    color: #e2e8f0 !important;
    line-height: 1.85 !important;
  }
  html.dark .blog-content strong,
  html.dark .blog-content b,
  html.dark .blog-content th {
    color: #ffffff !important;
    font-weight: 700 !important;
  }
  html.dark .blog-content h1,
  html.dark .blog-content h2,
  html.dark .blog-content h3,
  html.dark .blog-content h4 {
    color: #ffffff !important;
  }
  html.dark .blog-content a {
    color: #818cf8 !important;
  }
  html.dark .blog-content a:hover {
    color: #a5b4fc !important;
    text-decoration: underline !important;
  }
  html.dark .blog-content code {
    color: #93c5fd !important;
    background: rgba(15, 23, 42, 0.9) !important;
    border: 1px solid rgba(99, 102, 241, 0.3) !important;
  }

  /* 2. DARK MODE GENERIC DIV CARDS & CONTAINERS */
  html.dark .blog-content div {
    color: #e2e8f0 !important;
  }
  
  /* Catch all light-background card divs and convert them to dark glass cards */
  html.dark .blog-content div[style*="background-color: #f"],
  html.dark .blog-content div[style*="background-color: #e"],
  html.dark .blog-content div[style*="background-color: #d"],
  html.dark .blog-content div[style*="background-color: #c"],
  html.dark .blog-content div[style*="background-color: white"],
  html.dark .blog-content div[style*="background-color: #ffffff"],
  html.dark .blog-content div[style*="background: #fff"],
  html.dark .blog-content div[style*="background:#fff"],
  html.dark .blog-content div[style*="background: #e"],
  html.dark .blog-content div[style*="background: #f"],
  html.dark .blog-content div[style*="background:#f"],
  html.dark .blog-content div[style*="background: linear-gradient(135deg, #f"],
  html.dark .blog-content div[style*="background: linear-gradient(to right, #f"] {
    background: rgba(15, 23, 42, 0.88) !important;
    border: 1px solid rgba(99, 102, 241, 0.25) !important;
    color: #e2e8f0 !important;
  }

  /* 3. DARK MODE SEMANTIC CALLOUT BOXES */
  /* Green / Tip / Success Callouts */
  html.dark .blog-content div[style*="#f0fdf4"],
  html.dark .blog-content div[style*="#e6f4ea"],
  html.dark .blog-content div[style*="#f1f8e9"],
  html.dark .blog-content div[style*="#e0f2f1"],
  html.dark .blog-content div[style*="border-left: 4px solid #16a34a"],
  html.dark .blog-content div[style*="border-left: 4px solid #34a853"] {
    background: rgba(6, 78, 59, 0.35) !important;
    border: 1px solid rgba(16, 185, 129, 0.35) !important;
    border-left: 4px solid #10b981 !important;
    color: #d1fae5 !important;
  }
  html.dark .blog-content div[style*="#f0fdf4"] *,
  html.dark .blog-content div[style*="#e6f4ea"] * {
    color: #d1fae5 !important;
  }
  html.dark .blog-content div[style*="#f0fdf4"] strong,
  html.dark .blog-content div[style*="#e6f4ea"] strong {
    color: #ffffff !important;
  }

  /* Blue / Info Callouts */
  html.dark .blog-content div[style*="#eff6ff"],
  html.dark .blog-content div[style*="#e3f2fd"],
  html.dark .blog-content div[style*="#e8f4fd"],
  html.dark .blog-content div[style*="#e8f0fe"],
  html.dark .blog-content div[style*="border-left: 4px solid #3b82f6"],
  html.dark .blog-content div[style*="border-left: 4px solid #1a73e8"] {
    background: rgba(30, 58, 138, 0.35) !important;
    border: 1px solid rgba(59, 130, 246, 0.35) !important;
    border-left: 4px solid #3b82f6 !important;
    color: #dbeafe !important;
  }
  html.dark .blog-content div[style*="#eff6ff"] *,
  html.dark .blog-content div[style*="#e3f2fd"] * {
    color: #dbeafe !important;
  }
  html.dark .blog-content div[style*="#eff6ff"] strong,
  html.dark .blog-content div[style*="#e3f2fd"] strong {
    color: #ffffff !important;
  }

  /* Red / Warning / Alert Callouts */
  html.dark .blog-content div[style*="#fef2f2"],
  html.dark .blog-content div[style*="#ffebee"],
  html.dark .blog-content div[style*="#fce8e6"],
  html.dark .blog-content div[style*="#fbe9e7"],
  html.dark .blog-content div[style*="border-left: 4px solid #ef4444"],
  html.dark .blog-content div[style*="border-left: 4px solid #c62828"] {
    background: rgba(69, 10, 10, 0.4) !important;
    border: 1px solid rgba(239, 68, 68, 0.35) !important;
    border-left: 4px solid #ef4444 !important;
    color: #fecaca !important;
  }
  html.dark .blog-content div[style*="#fef2f2"] *,
  html.dark .blog-content div[style*="#ffebee"] * {
    color: #fecaca !important;
  }
  html.dark .blog-content div[style*="#fef2f2"] strong,
  html.dark .blog-content div[style*="#ffebee"] strong {
    color: #ffffff !important;
  }

  /* Amber / Orange / Note Callouts */
  html.dark .blog-content div[style*="#fff3e0"],
  html.dark .blog-content div[style*="#fef6e0"],
  html.dark .blog-content div[style*="#fde293"] {
    background: rgba(120, 53, 15, 0.35) !important;
    border: 1px solid rgba(245, 158, 11, 0.35) !important;
    border-left: 4px solid #f59e0b !important;
    color: #fef3c7 !important;
  }

  /* Inner Card Divider Lines (e.g. 💡 실무자를 위한 핵심 3줄 요약) */
  html.dark .blog-content div[style*="border-bottom"] {
    border-color: rgba(99, 102, 241, 0.4) !important;
    color: #ffffff !important;
  }

  /* 4. DARK MODE TABLES */
  html.dark .blog-content table {
    background-color: rgba(15, 23, 42, 0.85) !important;
    border-color: rgba(99, 102, 241, 0.3) !important;
  }
  html.dark .blog-content thead tr,
  html.dark .blog-content tr[style*="background"] {
    background: rgba(30, 41, 59, 0.95) !important;
  }
  html.dark .blog-content th {
    background: rgba(30, 41, 59, 0.95) !important;
    color: #ffffff !important;
    border-color: rgba(99, 102, 241, 0.3) !important;
  }
  html.dark .blog-content tr {
    background-color: transparent !important;
  }
  html.dark .blog-content tr:nth-child(even) {
    background-color: rgba(30, 41, 59, 0.45) !important;
  }
  html.dark .blog-content td {
    color: #e2e8f0 !important;
    border-color: rgba(99, 102, 241, 0.2) !important;
  }

  /* 5. LIGHT MODE READABILITY */
  html:not(.dark) .blog-content {
    color: #1e293b !important;
  }
  html:not(.dark) .blog-content p,
  html:not(.dark) .blog-content li,
  html:not(.dark) .blog-content span,
  html:not(.dark) .blog-content td {
    color: #334155 !important;
    line-height: 1.85 !important;
  }
  html:not(.dark) .blog-content strong,
  html:not(.dark) .blog-content b,
  html:not(.dark) .blog-content th {
    color: #0f172a !important;
    font-weight: 700 !important;
  }
  html:not(.dark) .blog-content table {
    background-color: #ffffff !important;
    border-color: #cbd5e1 !important;
  }
  html:not(.dark) .blog-content th {
    background-color: #f1f5f9 !important;
    color: #0f172a !important;
    border-color: #cbd5e1 !important;
  }
  html:not(.dark) .blog-content td {
    color: #334155 !important;
    border-color: #e2e8f0 !important;
  }
</style>
