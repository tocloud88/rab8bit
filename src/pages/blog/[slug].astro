---
import Layout from '../../layouts/Layout.astro';
import { BLOGS_DATA, type BlogPost } from '../../data/blogsData';

export async function getStaticPaths() {
  return BLOGS_DATA.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

// Related posts
const relatedPosts = BLOGS_DATA.filter((p) => p.id !== post.id).slice(0, 4);
---

<Layout
  title={`${post.title} | rab8bit AI 블로그`}
  description={post.excerpt}
>
  <div class="container mx-auto px-4 py-8 max-w-4xl space-y-8">
    {/* Navigation Breadcrumb */}
    <div class="flex items-center gap-2 text-xs text-slate-400">
      <a href="/" class="hover:text-white">홈</a>
      <span>/</span>
      <a href="/blog" class="hover:text-white">블로그</a>
      <span>/</span>
      <span class="text-indigo-400 truncate max-w-xs">{post.title}</span>
    </div>

    {/* Post Header */}
    <div class="space-y-4 border-b border-indigo-500/20 pb-6">
      <div class="flex flex-wrap items-center gap-2">
        <span class="px-3 py-1 rounded-full bg-indigo-950/80 text-indigo-300 text-xs font-bold border border-indigo-800/50">
          AI 아티클
        </span>
        <span class="text-xs text-slate-500">•</span>
        <span class="text-xs text-slate-400">{post.date}</span>
        <span class="text-xs text-slate-500">•</span>
        <span class="text-xs text-slate-400 font-medium">작성자: {post.author}</span>
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white leading-tight tracking-tight">
        {post.title}
      </h1>

      <p class="text-sm sm:text-base text-slate-300 leading-relaxed bg-slate-900/50 p-4 rounded-2xl border border-indigo-500/20">
        💡 {post.excerpt}
      </p>

      {/* Tags */}
      {post.tags && post.tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 pt-2">
          {post.tags.map((tag) => (
            <a
              href={`/blog`}
              class="text-xs px-2.5 py-1 rounded-lg bg-slate-800/80 text-slate-400 hover:text-indigo-300 hover:bg-slate-700/80 transition-colors border border-slate-700/50"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}
    </div>

    {/* Featured Thumbnail if present */}
    {post.thumbnail && (
      <div class="rounded-2xl overflow-hidden border border-slate-800 shadow-2xl aspect-[16/9] bg-slate-950 max-h-[420px]">
        <img
          src={post.thumbnail}
          alt={post.title}
          class="w-full h-full object-cover"
        />
      </div>
    )}

    {/* Rich HTML Content Body with Tailwind Typography */}
    <article class="prose prose-invert prose-indigo max-w-none prose-headings:font-bold prose-headings:text-white prose-p:text-slate-300 prose-p:leading-relaxed prose-a:text-indigo-400 prose-a:no-underline hover:prose-a:underline prose-code:text-indigo-300 prose-code:bg-slate-900 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-img:rounded-2xl prose-img:border prose-img:border-slate-800 space-y-4">
      <div class="blog-content bg-slate-900/30 p-4 sm:p-8 rounded-3xl border border-slate-800/80 leading-relaxed" set:html={post.content} />
    </article>

    {/* Back to Blog List CTA */}
    <div class="pt-6 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
      <a
        href="/blog"
        class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white text-xs sm:text-sm font-bold transition-all flex items-center gap-2 border border-slate-700"
      >
        <span>&larr;</span> 목록으로 돌아가기
      </a>
      <div class="flex items-center gap-2 text-xs text-slate-400">
        <span>더 많은 실무 팁 확인:</span>
        <a href="/insights" class="text-indigo-400 font-bold hover:underline">인사이트 보기 &rarr;</a>
      </div>
    </div>

    {/* Related Posts Section (4 cols Web, 2 cols Mobile) */}
    <div class="space-y-4 pt-8">
      <h2 class="text-xl font-bold text-white flex items-center gap-2">
        <span>📚</span> 다른 인기 아티클
      </h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3.5 sm:gap-4">
        {relatedPosts.map((rel) => (
          <a
            href={`/blog/${rel.id}`}
            class="stitch-card p-3.5 rounded-2xl flex flex-col justify-between group hover:border-indigo-500/50 transition-all hover:-translate-y-1"
          >
            <div class="space-y-1.5">
              <span class="text-[10px] text-slate-500">{rel.date}</span>
              <h3 class="font-bold text-xs text-white group-hover:text-indigo-400 transition-colors line-clamp-2 leading-snug">
                {rel.title}
              </h3>
            </div>
            <span class="text-[11px] text-indigo-400 font-semibold mt-3 pt-2 border-t border-slate-800 group-hover:translate-x-1 transition-transform">
              읽기 &rarr;
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
