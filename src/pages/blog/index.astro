---
import Layout from '../../layouts/Layout.astro';
import BlogDirectory from '../../components/blog/BlogDirectory';
---

<Layout
  title="AI 인사이트 블로그 & 실무 가이드 - rab8bit"
  description="최신 AI 트렌드, 검증된 프롬프트 엔지니어링 가이드, 바이브 코딩 및 AI 활용 전략을 깊이 있게 분석하는 블로그입니다."
>
  <div class="container mx-auto px-4 py-8 space-y-8">
    {/* Page Header */}
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-bold">
        <span>📝</span> 54편의 고품질 실무 AI 아티클
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        AI 인사이트 <span class="gradient-text-stitch">블로그</span>
      </h1>
      <p class="text-sm sm:text-base text-slate-400">
        AI 기술의 홍수 속에서 실질적인 활용법과 검증된 도구만을 엄선하여 깊이 있는 가이드를 제공합니다.
      </p>
    </div>

    {/* Interactive Blog Directory */}
    <BlogDirectory client:load />
  </div>
</Layout>
