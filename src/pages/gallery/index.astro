---
import Layout from '../../layouts/Layout.astro';
import GalleryDirectory from '../../components/gallery/GalleryDirectory';
---

<Layout
  title="🍌 바나나 AI 갤러리 & 프롬프트 - rab8bit"
  description="나노바나나 및 최신 생성형 AI 모델로 제작된 감각적인 AI 아트워크와 실제 사용된 이미지 생성 프롬프트 모음입니다."
>
  <div class="container mx-auto px-4 py-8 space-y-8">
    {/* Page Header */}
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-yellow-500/10 border border-yellow-500/20 text-yellow-400 text-xs font-bold">
        <span>🍌</span> 나노바나나 & 최신 AI 생성 이미지 아카이브
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        바나나 AI <span class="gradient-text-stitch">갤러리</span>
      </h1>
      <p class="text-sm sm:text-base text-slate-400">
        검증된 고화질 AI 생성 이미지의 프롬프트를 원클릭으로 복사하여 나만의 미드저니, 바나나, DALL-E 작품을 만들어보세요.
      </p>
    </div>

    {/* Interactive Gallery */}
    <GalleryDirectory client:load />
  </div>
</Layout>
