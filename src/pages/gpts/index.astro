---
import Layout from '../../layouts/Layout.astro';
import AdBanner from '../../components/ads/AdBanner.astro';
import PromptsDirectory from '../../components/prompts/PromptsDirectory';
---

<Layout
  title="검증된 GPTs 챗봇지침 & 커스텀 인스트럭션 - rab8bit"
  description="ChatGPT, Custom GPTs, Claude Projects에 즉시 적용 가능한 100개의 고성능 챗봇 커스텀 지침 모음입니다."
>
  <div class="w-full space-y-8">
    {/* Page Header */}
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-pink-500/10 border border-pink-500/20 text-pink-400 text-xs font-bold">
        <span>🤖</span> 100+ 커스텀 GPTs 지침 라이브러리
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        챗봇지침 <span class="gradient-text-stitch">(GPTs)</span> 모음
      </h1>
      <p class="text-sm sm:text-base text-slate-400">
        나만의 AI 어시스턴트, 전문가 어드바이저, 코딩 튜터, 콘텐츠 크리에이터를 구축하는 완벽한 시스템 프롬프트입니다.
      </p>
    </div>

    {/* Top Ad Slot */}
    <AdBanner type="leaderboard" label="맞춤형 AI 챗봇 & 솔루션 스폰서" />

    {/* Interactive Prompts Directory in GPTs Tab */}
    <PromptsDirectory client:load initialTab="gpts" />
  </div>
</Layout>
