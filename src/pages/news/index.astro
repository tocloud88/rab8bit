---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import AdBanner from '../../components/ads/AdBanner.astro';

const posts = await getCollection('news');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="AI 뉴스 및 트렌드 | rab8bit"
  description="최신 AI 트렌드, 실무 생산성 팁 및 ChatGPT/Claude 활용 가이드를 매주 업데이트합니다."
>
  <section class="max-w-4xl mx-auto space-y-8">
    <div class="text-center space-y-3 py-4">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        AI 뉴스 & 트렌드
      </h1>
      <p class="text-slate-600 dark:text-slate-400 max-w-xl mx-auto text-sm sm:text-base">
        급변하는 AI 시대, 업무와 일상에 바로 적용 가능한 핵심 정보와 실무 노하우를 확인해보세요.
      </p>
    </div>

    {/* Top Leaderboard Ad Slot */}
    <AdBanner type="leaderboard" />

    {/* Articles Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {sortedPosts.map((post) => (
        <a
          href={`/news/${post.id}`}
          class="group bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700/80 rounded-2xl p-6 transition-all hover:shadow-xl hover:-translate-y-1 flex flex-col justify-between"
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="px-3 py-1 bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 text-xs font-semibold rounded-full border border-indigo-100 dark:border-indigo-900/50">
                {post.data.category}
              </span>
              <span class="text-xs text-slate-400 dark:text-slate-500">
                {post.data.pubDate.toISOString().split('T')[0]}
              </span>
            </div>
            
            <h2 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
              {post.data.title}
            </h2>
            
            <p class="text-sm text-slate-600 dark:text-slate-400 line-clamp-2">
              {post.data.description}
            </p>
          </div>

          <div class="pt-4 mt-4 border-t border-slate-100 dark:border-slate-700/50 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
            <span>{post.data.author}</span>
            <span class="font-medium group-hover:translate-x-1 transition-transform inline-flex items-center gap-1 text-indigo-600 dark:text-indigo-400">
              읽기 &rarr;
            </span>
          </div>
        </a>
      ))}
    </div>

    {/* Bottom Horizontal Ad Slot */}
    <AdBanner type="horizontal" className="mt-8" />
  </section>
</Layout>

