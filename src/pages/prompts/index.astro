---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const prompts = await getCollection('prompts');
const sortedPrompts = prompts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="검증된 AI 프롬프트 라이브러리 | rab8bit"
  description="ChatGPT, Claude, Midjourney 등 업무와 창작에 바로 복사해서 쓰는 검증된 고성능 AI 프롬프트 모음입니다."
>
  <section class="max-w-5xl mx-auto space-y-8">
    <div class="text-center space-y-3 py-4">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        AI 프롬프트 라이브러리
      </h1>
      <p class="text-slate-600 dark:text-slate-400 max-w-xl mx-auto text-sm sm:text-base">
        원하는 AI 도구와 목적에 맞는 검증된 실무 지시문을 클릭 한 번으로 복사하여 활용해보세요.
      </p>
    </div>

    {/* Prompts Grid (Mobile 2 cols, Desktop 4 cols) */}
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3.5 sm:gap-5">
      {sortedPrompts.map((item) => (
        <a
          href={`/prompts/${item.id}`}
          class="group stitch-card rounded-2xl sm:rounded-3xl p-3.5 sm:p-5 transition-all hover:shadow-xl hover:-translate-y-1 flex flex-col justify-between border border-indigo-500/20 hover:border-purple-500/50"
        >
          <div class="space-y-2.5">
            <div class="flex items-center justify-between">
              <span class="px-2 py-0.5 bg-purple-950/60 text-purple-300 text-[10px] font-semibold rounded-full border border-purple-800/50">
                {item.data.category}
              </span>
              {item.data.featured && (
                <span class="text-[9px] font-bold px-1.5 py-0.2 bg-amber-900/50 text-amber-300 rounded">
                  추천
                </span>
              )}
            </div>

            <h2 class="text-sm sm:text-base font-bold text-white group-hover:text-purple-400 transition-colors leading-snug line-clamp-2">
              {item.data.title}
            </h2>

            <p class="text-[11px] sm:text-xs text-slate-400 line-clamp-2">
              {item.data.description}
            </p>
          </div>

          <div class="pt-3 mt-3 border-t border-slate-800/80 flex items-center justify-between text-[11px] text-slate-500">
            <div class="hidden sm:flex flex-wrap gap-1">
              {item.data.tags.slice(0, 1).map((t) => (
                <span class="text-[9px] text-slate-400">#{t}</span>
              ))}
            </div>
            <span class="font-medium text-purple-400 group-hover:translate-x-1 transition-transform inline-flex items-center gap-0.5 text-[11px]">
              복사 &rarr;
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
