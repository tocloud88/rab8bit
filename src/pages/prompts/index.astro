---
import Layout from '../../layouts/Layout.astro';
import AdBanner from '../../components/ads/AdBanner.astro';
import PromptsDirectory from '../../components/prompts/PromptsDirectory';
---

<Layout
  title="검증된 AI 프롬프트 & 챗봇지침 (GPTs) 라이브러리 - rab8bit"
  description="ChatGPT, Claude, Gemini에서 즉시 복사해서 쓰는 370+개의 검증된 실무 프롬프트 및 GPTs 챗봇 지침 모음입니다."
>
  <div class="container mx-auto px-4 py-8 space-y-8">
    {/* Page Header */}
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs font-bold">
        <span>💬</span> 374+ 검증된 실전 프롬프트 & 챗봇지침
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        AI 프롬프트 & <span class="gradient-text-stitch">챗봇지침</span>
      </h1>
      <p class="text-sm sm:text-base text-slate-400">
        비즈니스, 마케팅, 코딩, 글쓰기, 업무 자동화 등 목적에 맞는 최적의 프롬프트를 원클릭으로 복사하여 활용하세요.
      </p>
    </div>

    {/* Top Ad Slot */}
    <AdBanner type="leaderboard" label="AI 프롬프트 & 생산성 도구 스폰서" />

    {/* Interactive Prompts Directory */}
    <PromptsDirectory client:load initialTab="prompts" />
  </div>
</Layout>
