---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const prompts = await getCollection('prompts');
const sortedPrompts = prompts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="검증된 AI 프롬프트 라이브러리 | rab8bit"
  description="ChatGPT, Claude, Midjourney 등 업무와 창작에 바로 복사해서 쓰는 검증된 고성능 AI 프롬프트 모음입니다."
>
  <section class="max-w-5xl mx-auto space-y-8">
    <div class="text-center space-y-3 py-4">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        AI 프롬프트 라이브러리
      </h1>
      <p class="text-slate-600 dark:text-slate-400 max-w-xl mx-auto text-sm sm:text-base">
        원하는 AI 도구와 목적에 맞는 검증된 실무 지시문을 클릭 한 번으로 복사하여 활용해보세요.
      </p>
    </div>

    {/* Prompts Grid */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {sortedPrompts.map((item) => (
        <a
          href={`/prompts/${item.id}`}
          class="group bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700/80 rounded-2xl p-6 transition-all hover:shadow-xl hover:-translate-y-1 flex flex-col justify-between"
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="px-3 py-1 bg-purple-50 dark:bg-purple-950/60 text-purple-600 dark:text-purple-400 text-xs font-semibold rounded-full border border-purple-100 dark:border-purple-900/50">
                {item.data.category}
              </span>
              {item.data.featured && (
                <span class="text-[10px] font-bold px-2 py-0.5 bg-amber-100 dark:bg-amber-900/50 text-amber-700 dark:text-amber-300 rounded">
                  추천
                </span>
              )}
            </div>

            <h2 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
              {item.data.title}
            </h2>

            <p class="text-xs text-slate-600 dark:text-slate-400 line-clamp-3">
              {item.data.description}
            </p>
          </div>

          <div class="pt-4 mt-4 border-t border-slate-100 dark:border-slate-700/50 flex items-center justify-between text-xs text-slate-500">
            <div class="flex flex-wrap gap-1">
              {item.data.tags.slice(0, 2).map((t) => (
                <span class="text-[10px] text-slate-400">#{t}</span>
              ))}
            </div>
            <span class="font-medium text-purple-600 dark:text-purple-400 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
              복사하기 &rarr;
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
