---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import CopyButton from '../../components/CopyButton';
import AdBanner from '../../components/ads/AdBanner.astro';

export async function getStaticPaths() {
  const prompts = await getCollection('prompts');
  return prompts.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<Layout title={`${item.data.title} - AI 프롬프트 | rab8bit`} description={item.data.description}>
  <article class="max-w-3xl mx-auto space-y-8">
    <div class="space-y-4 text-center border-b border-slate-200 dark:border-slate-800 pb-6">
      <div class="inline-flex items-center gap-2">
        <span class="px-3 py-1 bg-purple-50 dark:bg-purple-950/60 text-purple-600 dark:text-purple-400 text-xs font-semibold rounded-full border border-purple-100 dark:border-purple-900/50">
          {item.data.category}
        </span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white leading-tight">
        {item.data.title}
      </h1>

      <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base max-w-xl mx-auto">
        {item.data.description}
      </p>
    </div>

    {/* Prompt Code Block & Action Box */}
    <div class="bg-slate-900 text-slate-100 rounded-2xl p-6 shadow-2xl relative space-y-4 border border-slate-800">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3 text-xs text-slate-400">
        <span class="font-mono">PROMPT TEMPLATE</span>
        <span>{item.data.category} 지원</span>
      </div>

      <pre class="whitespace-pre-wrap font-mono text-sm sm:text-base leading-relaxed text-indigo-200 select-all p-2 overflow-x-auto">{item.data.promptText}</pre>

      <div class="pt-2 flex justify-end">
        <CopyButton client:load text={item.data.promptText} label="프롬프트 복사하기" />
      </div>
    </div>

    {/* In-Article Mid Ad Slot */}
    <AdBanner type="in-article" />

    {/* Usage Tips & Markdown Content */}
    <div class="prose prose-slate dark:prose-invert max-w-none space-y-4 bg-slate-50 dark:bg-slate-800/40 p-6 rounded-2xl border border-slate-200 dark:border-slate-800">
      <h3 class="text-lg font-bold text-slate-900 dark:text-white">활용 가이드</h3>
      <Content />
    </div>

    {/* Footer Navigation */}
    <div class="pt-6 border-t border-slate-200 dark:border-slate-800 flex justify-between items-center">
      <a
        href="/prompts"
        class="inline-flex items-center text-sm font-medium text-purple-600 dark:text-purple-400 hover:underline"
      >
        &larr; 프롬프트 목록으로 돌아가기
      </a>
    </div>
  </article>
</Layout>

