---
import SEO from '../components/SEO.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: '홈', icon: '🏠' },
  { href: '/news', label: 'AI 뉴스', badge: 'New' },
  { href: '/tools', label: '스마트 도구', dropdown: true },
  { href: '/ai-tools', label: '추천 AI 사이트', badge: '152+' },
  { href: '/prompts', label: 'AI 프롬프트', badge: 'Hot' },
  { href: '/about', label: '소개' },
  { href: '/contact', label: '문의' },
];
---

<!doctype html>
<html lang="ko" class="scroll-smooth dark">
  <head>
    <SEO title={title} description={description} />
  </head>
  <body class="min-h-screen text-slate-100 flex flex-col font-sans antialiased stitch-bg selection:bg-indigo-500 selection:text-white">
    {/* Header with Category Menus */}
    <header class="sticky top-0 z-50 backdrop-blur-2xl bg-slate-950/85 border-b border-indigo-500/20 transition-all shadow-xl shadow-indigo-950/20">
      <div class="container mx-auto px-4 h-16 flex items-center justify-between gap-4">
        {/* Brand Logo */}
        <a href="/" class="flex items-center gap-2.5 group shrink-0">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-500 via-purple-500 to-pink-500 p-0.5 shadow-lg shadow-indigo-500/30 group-hover:scale-105 transition-transform">
            <div class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center font-extrabold text-white text-base">
              🐰
            </div>
          </div>
          <div class="flex items-baseline gap-1">
            <span class="font-heading font-extrabold text-xl tracking-tight text-white group-hover:text-indigo-400 transition-colors">
              rab<span class="gradient-text-stitch">8bit</span>
            </span>
          </div>
        </a>

        {/* Category Navigation Links (GPT PARK style) */}
        <nav class="hidden lg:flex items-center gap-1 xl:gap-2">
          {navItems.map((item) => {
            const isActive = item.href === '/' 
              ? currentPath === '/' 
              : currentPath.startsWith(item.href);
            
            return (
              <a
                href={item.href}
                class={`px-3.5 py-2 rounded-xl text-sm font-semibold transition-all duration-200 flex items-center gap-1.5 relative group ${
                  isActive
                    ? 'text-indigo-400 font-bold bg-indigo-500/10 border border-indigo-500/30 shadow-sm'
                    : 'text-slate-300 hover:text-white hover:bg-slate-800/60'
                }`}
              >
                {item.icon && <span class="text-xs">{item.icon}</span>}
                <span>{item.label}</span>
                {item.badge && (
                  <span class={`text-[10px] px-1.5 py-0.2 rounded-full font-bold uppercase tracking-wider ${
                    item.badge === 'Hot' 
                      ? 'bg-pink-500/20 text-pink-400 border border-pink-500/30' 
                      : 'bg-indigo-500/20 text-indigo-300 border border-indigo-500/30'
                  }`}>
                    {item.badge}
                  </span>
                )}
              </a>
            );
          })}
        </nav>

        {/* Right Section: Integrated Search & Quick Actions */}
        <div class="flex items-center gap-2 sm:gap-3">
          {/* Integrated Search Bar */}
          <div class="relative hidden sm:block w-44 md:w-56">
            <input
              type="text"
              id="header-search-input"
              placeholder="통합 검색..."
              class="w-full bg-slate-900/90 text-slate-200 text-xs rounded-xl pl-8 pr-8 py-2 border border-slate-800 focus:outline-none focus:border-indigo-500/60 focus:ring-2 focus:ring-indigo-500/20 transition-all placeholder:text-slate-500"
            />
            <svg
              class="w-3.5 h-3.5 absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            <kbd class="hidden md:inline-block absolute right-2.5 top-1/2 -translate-y-1/2 text-[10px] text-slate-500 bg-slate-950 px-1 py-0.5 rounded border border-slate-800">
              ⌘K
            </kbd>
          </div>

          {/* Quick Action / Theme Button */}
          <button
            type="button"
            aria-label="테마 전환"
            title="테마 전환"
            class="p-2 rounded-xl text-slate-400 hover:text-amber-300 hover:bg-slate-900 border border-slate-800 transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </button>

          {/* AI Prompt CTA */}
          <a
            href="/prompts"
            class="hidden md:inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 hover:from-indigo-400 hover:to-pink-400 text-white text-xs font-bold shadow-md shadow-purple-500/20 transition-all hover:scale-105 active:scale-95 shrink-0"
          >
            <span>✨ 프롬프트</span>
          </a>
        </div>
      </div>

      {/* Mobile Navigation bar */}
      <div class="lg:hidden flex items-center justify-around py-2 px-2 border-t border-slate-800/80 bg-slate-950/95 text-xs overflow-x-auto">
        {navItems.map((item) => {
          const isActive = item.href === '/' 
            ? currentPath === '/' 
            : currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              class={`flex flex-col items-center gap-0.5 py-1 px-2.5 rounded-lg whitespace-nowrap transition-colors ${
                isActive ? 'text-indigo-400 font-bold' : 'text-slate-400 hover:text-slate-200'
              }`}
            >
              <span class="text-xs">{item.icon || '📌'}</span>
              <span class="text-[11px]">{item.label}</span>
            </a>
          );
        })}
      </div>
    </header>

    {/* Main Container */}
    <main class="flex-1 container mx-auto px-4 py-8 md:py-12">
      <slot />
    </main>

    {/* Footer */}
    <footer class="border-t border-indigo-500/20 bg-slate-950/90 backdrop-blur-2xl py-12">
      <div class="container mx-auto px-4 space-y-8">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 pb-8 border-b border-slate-800/80">
          <div class="space-y-2">
            <div class="flex items-center gap-2">
              <span class="font-heading font-extrabold text-2xl tracking-tight text-white">
                rab<span class="gradient-text-stitch">8bit</span>
              </span>
            </div>
            <p class="text-xs sm:text-sm text-slate-400 max-w-md">
              Google Stitch 스타일 네온 디스플레이 & AI 프롬프트 라이브러리와 스마트 유틸리티 툴을 선사합니다.
            </p>
          </div>

          <div class="flex flex-wrap gap-4 text-xs font-semibold text-slate-400">
            <a href="/about" class="hover:text-indigo-400 transition-colors">서비스 소개</a>
            <a href="/terms" class="hover:text-indigo-400 transition-colors">이용약관</a>
            <a href="/privacy-policy" class="hover:text-indigo-400 transition-colors">개인정보처리방침</a>
            <a href="/contact" class="hover:text-indigo-400 transition-colors">문의하기</a>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate-500">
          <p>&copy; {new Date().getFullYear()} rab8bit.com. All rights reserved.</p>
          <p class="text-[11px] text-slate-400 flex items-center gap-1">
            <span>Powered by Gemini & Stitch UI Engine</span>
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
