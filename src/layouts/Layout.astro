---
import SEO from '../components/SEO.astro';
import SideRailAds from '../components/ads/SideRailAds.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article' | 'application' | 'faq';
  articleData?: {
    datePublished?: string;
    dateModified?: string;
    author?: string;
    tags?: string[];
    section?: string;
  };
  toolData?: {
    category?: string;
    operatingSystem?: string;
  };
  faqData?: Array<{
    question: string;
    answer: string;
  }>;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: '홈', icon: '🏠' },
  { href: '/insights', label: '인사이트' },
  { href: '/ai-tools', label: 'AI 도구' },
  { href: '/blog', label: '블로그' },
  { href: '/tools', label: '웹 도구' },
  { href: '/prompts', label: '프롬프트' },
  { href: '/gpts', label: '챗봇지침' },
  { href: '/gallery', label: '바나나 갤러리', icon: '🍌' },
  { href: '/ebooks', label: '전자책' },
  { href: '/faq', label: 'FAQ' },
];

const isPortalCategoryPage = [
  '/',
  '/insights',
  '/ai-tools',
  '/blog',
  '/tools',
  '/prompts',
  '/gpts',
  '/gallery',
  '/ebooks',
  '/faq'
].some(p => currentPath === p || currentPath === p + '/' || currentPath === p + '/index.html');
---

<!doctype html>
<html lang="ko" class="scroll-smooth">
  <head>
    <SEO {...Astro.props} />

    <script is:inline>
      (function() {
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col font-sans antialiased stitch-bg selection:bg-indigo-500 selection:text-white transition-colors duration-300 relative">
    {/* Widescreen Fixed Left/Right Skyscraper Side Rail Ads */}
    <SideRailAds />

    {/* Header with Category Menus */}
    <header class="sticky top-0 z-50 backdrop-blur-2xl border-b border-[var(--header-border)] transition-all duration-300 shadow-sm dark:shadow-indigo-950/20">
      <div class="container mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-3">
        {/* Brand Logo */}
        <a href="/" class="flex items-center gap-2.5 group shrink-0">
          <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-tr from-indigo-500/15 via-purple-500/15 to-pink-500/15 border border-indigo-500/30 flex items-center justify-center shadow-md shadow-indigo-500/10 group-hover:scale-105 group-hover:border-purple-500/50 transition-all p-1">
            <img src="/logo.svg" alt="rab8bit 픽셀 토끼 로고" class="w-full h-full object-contain [image-rendering:pixelated] drop-shadow-sm" />
          </div>
          <div class="flex items-baseline gap-1">
            <span class="font-heading font-extrabold text-xl tracking-tight text-slate-900 dark:text-white group-hover:text-indigo-500 transition-colors">
              rab<span class="gradient-text-stitch">8bit</span>
            </span>
          </div>
        </a>

        {/* Category Navigation Links (Visible on Tablet/Desktop) */}
        <nav class="hidden lg:flex items-center gap-1 xl:gap-1.5">
          {navItems.map((item) => {
            const isActive = item.href === '/' 
              ? currentPath === '/' 
              : currentPath.startsWith(item.href);
            
            return (
              <a
                href={item.href}
                class={`px-2.5 xl:px-3 py-1.5 rounded-xl text-xs font-semibold transition-all duration-200 flex items-center gap-1 relative group ${
                  isActive
                    ? 'text-indigo-600 dark:text-indigo-400 font-bold bg-indigo-50 dark:bg-indigo-500/15 border border-indigo-200 dark:border-indigo-500/35 shadow-sm'
                    : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/70'
                }`}
              >
                {item.icon && <span class="text-xs">{item.icon}</span>}
                <span>{item.label}</span>
              </a>
            );
          })}
        </nav>

        {/* Right Section: Integrated Search & Dark Mode Toggle Button */}
        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
          {/* Integrated Search Input Form */}
          <form action="/search" method="GET" class="relative flex items-center">
            <input
              type="text"
              name="q"
              placeholder="통합 검색..."
              class="w-32 sm:w-40 md:w-48 bg-slate-100 dark:bg-slate-900/90 text-slate-900 dark:text-slate-200 text-xs rounded-full pl-3.5 pr-7 py-1.5 border border-slate-300 dark:border-slate-700/80 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all placeholder:text-slate-400 shadow-inner"
            />
            <button
              type="submit"
              aria-label="통합 검색 실행"
              class="absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors p-0.5"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-4.35-4.35m0 0a7.5 7.5 0 10-10.6-10.6 7.5 7.5 0 0010.6 10.6z" />
              </svg>
            </button>
          </form>

          {/* Dark / Light Mode Toggle Button */}
          <button
            id="theme-toggle-btn"
            type="button"
            aria-label="다크 모드 / 라이트 모드 전환"
            title="다크 모드 / 라이트 모드 전환"
            class="p-2 rounded-full text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-800/80 hover:text-amber-500 dark:hover:text-amber-400 transition-all focus:outline-none flex items-center justify-center cursor-pointer border border-transparent hover:border-slate-300 dark:hover:border-slate-700"
          >
            {/* Sun Icon (Visible in dark mode) */}
            <svg id="theme-sun-icon" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="4" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41m14.14-14.14l-1.41 1.41" />
            </svg>

            {/* Moon Icon (Visible in light mode) */}
            <svg id="theme-moon-icon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>
        </div>
      </div>

      {/* Sub-Header Mobile Horizontal Scroll Navigation bar (Only on Standalone Pages < 1024px) */}
      {!isPortalCategoryPage && (
        <div class="lg:hidden relative border-t border-[var(--header-border)] bg-[var(--bg-header)]">
          {/* Left / Right Scroll Gradient Fades (Naver Style) */}
          <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-3 bg-gradient-to-r from-[var(--bg-header)] to-transparent z-10"></div>
          <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-3 bg-gradient-to-l from-[var(--bg-header)] to-transparent z-10"></div>

          <div id="mobile-nav-bar" class="flex items-center gap-1.5 py-2 px-3 text-xs overflow-x-auto scrollbar-none scroll-smooth select-none">
            {navItems.map((item) => {
              const isActive = item.href === '/' 
                ? currentPath === '/' 
                : currentPath.startsWith(item.href);
              return (
                <a
                  href={item.href}
                  id={isActive ? 'active-mobile-nav' : undefined}
                  class={`flex items-center gap-1 py-1.5 px-3 rounded-full whitespace-nowrap transition-all duration-200 text-xs shrink-0 font-medium ${
                    isActive 
                      ? 'text-white font-bold bg-gradient-to-r from-indigo-600 to-purple-600 shadow-sm shadow-indigo-500/25 scale-[1.02]' 
                      : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 bg-slate-100 dark:bg-slate-900/60 active:scale-95'
                  }`}
                >
                  {item.icon && <span class="text-xs">{item.icon}</span>}
                  <span>{item.label}</span>
                </a>
              );
            })}
          </div>
        </div>
      )}
    </header>

    {/* Main Container */}
    <main class="flex-1 container mx-auto px-4 sm:px-6 py-4 md:py-8">
      <slot />
    </main>

    {/* Footer */}
    <footer class="border-t border-[var(--footer-border)] bg-[var(--footer-bg)] backdrop-blur-2xl pt-12 pb-12 transition-colors duration-300">
      <div class="container mx-auto px-4 sm:px-6 space-y-12">
        {/* Brand & Mission Banner */}
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 pb-8 border-b border-[var(--header-border)]">
          <div class="space-y-2">
            <a href="/" class="flex items-center gap-2.5 group inline-flex">
              <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-indigo-500/15 via-purple-500/15 to-pink-500/15 border border-indigo-500/30 flex items-center justify-center p-1 group-hover:scale-105 transition-all">
                <img src="/logo.svg" alt="rab8bit 로고" class="w-full h-full object-contain [image-rendering:pixelated]" />
              </div>
              <span class="font-heading font-extrabold text-2xl tracking-tight text-slate-900 dark:text-white">
                rab<span class="gradient-text-stitch">8bit</span>
              </span>
            </a>
            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 max-w-xl leading-relaxed">
              최신 AI 인사이트, 370+ 검증된 프롬프트와 GPTs 지침, 130+ 인터랙티브 스마트 도구 및 엄선된 AI 디렉토리를 제공하는 올인원 플랫폼입니다.
            </p>
          </div>

          <div class="flex items-center gap-2">
            <a
              href="/search"
              class="px-3.5 py-2 rounded-xl bg-slate-100 dark:bg-slate-900/80 hover:bg-indigo-600 dark:hover:bg-indigo-600 text-slate-700 dark:text-slate-300 hover:text-white text-xs font-bold border border-slate-200 dark:border-indigo-500/20 transition-all flex items-center gap-1.5"
            >
              <span>🔍</span> 전체 통합 검색
            </a>
            <a
              href="/tools"
              class="px-3.5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-md shadow-indigo-500/20 transition-all flex items-center gap-1.5"
            >
              <span>⚡</span> 스마트 도구 전체보기 (130+)
            </a>
          </div>
        </div>

        {/* Multi-Column OpenAI Style Sitemap Grid */}
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-8 text-xs">
          {/* Column 1: AI 콘텐츠 & 리서치 */}
          <div class="space-y-3.5">
            <h4 class="font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider text-[13px] flex items-center gap-1.5">
              <span>📚</span> 콘텐츠 & 리서치
            </h4>
            <ul class="space-y-2.5">
              <li>
                <a href="/blog" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors flex items-center justify-between">
                  <span>블로그 아티클</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-indigo-500/10 text-indigo-500 font-bold">56</span>
                </a>
              </li>
              <li>
                <a href="/insights" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors flex items-center justify-between">
                  <span>영상 인사이트</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-purple-500/10 text-purple-500 font-bold">104</span>
                </a>
              </li>
              <li>
                <a href="/prompts" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors flex items-center justify-between">
                  <span>프롬프트 라이브러리</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-pink-500/10 text-pink-500 font-bold">274</span>
                </a>
              </li>
              <li>
                <a href="/gpts" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors flex items-center justify-between">
                  <span>GPTs 맞춤 지침</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-500 font-bold">100</span>
                </a>
              </li>
              <li>
                <a href="/ebooks" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  실무 AI 전자책
                </a>
              </li>
            </ul>
          </div>

          {/* Column 2: AI 도구 & 갤러리 */}
          <div class="space-y-3.5">
            <h4 class="font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider text-[13px] flex items-center gap-1.5">
              <span>🤖</span> AI 도구 & 모델
            </h4>
            <ul class="space-y-2.5">
              <li>
                <a href="/ai-tools" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors flex items-center justify-between">
                  <span>AI 도구 디렉토리</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-500 font-bold">120+</span>
                </a>
              </li>
              <li>
                <a href="/gallery" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors flex items-center justify-between">
                  <span>바나나 AI 갤러리</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-yellow-500/10 text-yellow-600 dark:text-yellow-400 font-bold">🍌 80</span>
                </a>
              </li>
              <li>
                <a href="/news" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  AI 테크 브리핑
                </a>
              </li>
            </ul>
          </div>

          {/* Column 3: 스마트 계산기 */}
          <div class="space-y-3.5">
            <h4 class="font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider text-[13px] flex items-center gap-1.5">
              <span>💰</span> 실무 & 금융 도구
            </h4>
            <ul class="space-y-2.5">
              <li>
                <a href="/tools/salary-calculator" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  2026 연봉 실수령액
                </a>
              </li>
              <li>
                <a href="/tools/severance-pay" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  퇴직금 자동 계산기
                </a>
              </li>
              <li>
                <a href="/tools/loan-calculator" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  대출 원리금 계산기
                </a>
              </li>
              <li>
                <a href="/tools/freelancer-tax" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  3.3% 프리랜서 원천징수
                </a>
              </li>
              <li>
                <a href="/tools/realtor-fee" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  부동산 중개보수 계산기
                </a>
              </li>
            </ul>
          </div>

          {/* Column 4: 라이프스타일 도구 */}
          <div class="space-y-3.5">
            <h4 class="font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider text-[13px] flex items-center gap-1.5">
              <span>🎯</span> 일상 편의 & 헬스
            </h4>
            <ul class="space-y-2.5">
              <li>
                <a href="/tools/dday-calculator" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  스마트 디데이(D-Day)
                </a>
              </li>
              <li>
                <a href="/tools/bmr-tdee-calc" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  기초대사량 & TDEE
                </a>
              </li>
              <li>
                <a href="/tools/quit-smoking" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  금연 세이빙 계산기
                </a>
              </li>
              <li>
                <a href="/tools/tarot-today" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  오늘의 타로 운세
                </a>
              </li>
              <li>
                <a href="/tools/ladder" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  인터랙티브 사다리타기
                </a>
              </li>
            </ul>
          </div>

          {/* Column 5: 개발자 & 웹 도구 */}
          <div class="space-y-3.5">
            <h4 class="font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider text-[13px] flex items-center gap-1.5">
              <span>⚙️</span> 개발자 & 생산성
            </h4>
            <ul class="space-y-2.5">
              <li>
                <a href="/tools/json-formatter" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  JSON 포맷터 & 검증기
                </a>
              </li>
              <li>
                <a href="/tools/base64-encoder" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  Base64 인코더/디코더
                </a>
              </li>
              <li>
                <a href="/tools/regex-tester" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  정규표현식(Regex) 테스터
                </a>
              </li>
              <li>
                <a href="/tools/cron-parser" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  Cron 표현식 생성기
                </a>
              </li>
              <li>
                <a href="/tools/qr-code" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  고화질 QR코드 생성기
                </a>
              </li>
            </ul>
          </div>

          {/* Column 6: 안내 및 정책 */}
          <div class="space-y-3.5">
            <h4 class="font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider text-[13px] flex items-center gap-1.5">
              <span>ℹ️</span> 서비스 & 정책
            </h4>
            <ul class="space-y-2.5">
              <li>
                <a href="/faq" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  자주 묻는 질문(FAQ)
                </a>
              </li>
              <li>
                <a href="/privacy-policy" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  개인정보 처리방침
                </a>
              </li>
              <li>
                <a href="/terms" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  이용약관
                </a>
              </li>
              <li>
                <a href="/contact" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  문의 및 제휴
                </a>
              </li>
            </ul>
          </div>
        </div>

        {/* Bottom Copyright & Status */}
        <div class="pt-8 border-t border-[var(--header-border)] flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate-500 dark:text-slate-400">
          <p>&copy; {new Date().getFullYear()} rab8bit.com. All rights reserved.</p>
          <div class="flex items-center gap-2 text-[11px]">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>All Services Operational</span>
          </div>
        </div>
      </div>
    </footer>

    {/* Theme Toggle Script */}
    <script is:inline>
      function initThemeToggle() {
        const toggleBtn = document.getElementById('theme-toggle-btn');
        const sunIcon = document.getElementById('theme-sun-icon');
        const moonIcon = document.getElementById('theme-moon-icon');

        function updateUI() {
          const isDark = document.documentElement.classList.contains('dark');
          if (isDark) {
            sunIcon?.classList.remove('hidden');
            moonIcon?.classList.add('hidden');
          } else {
            sunIcon?.classList.add('hidden');
            moonIcon?.classList.remove('hidden');
          }
        }

        updateUI();

        if (toggleBtn) {
          toggleBtn.onclick = function() {
            const isDark = document.documentElement.classList.contains('dark');
            if (isDark) {
              document.documentElement.classList.remove('dark');
              localStorage.setItem('theme', 'light');
            } else {
              document.documentElement.classList.add('dark');
              localStorage.setItem('theme', 'dark');
            }
            updateUI();
          };
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initThemeToggle);
      } else {
        initThemeToggle();
      }
      document.addEventListener('astro:after-swap', initThemeToggle);
    </script>
  </body>
</html>
