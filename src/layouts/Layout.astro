---
import SEO from '../components/SEO.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: '홈', icon: '🏠' },
  { href: '/blog', label: '블로그', badge: '55+' },
  { href: '/insights', label: '인사이트', badge: '92' },
  { href: '/tools', label: '프로그램', badge: '130+' },
  { href: '/prompts', label: '프롬프트', badge: '274' },
  { href: '/gpts', label: '챗봇지침', badge: '100' },
  { href: '/gallery', label: '바나나 갤러리', icon: '🍌' },
  { href: '/ai-tools', label: 'AI 도구', badge: '152+' },
  { href: '/ebooks', label: '전자책' },
  { href: '/faq', label: 'FAQ' },
];
---

<!doctype html>
<html lang="ko" class="scroll-smooth">
  <head>
    <SEO title={title} description={description} />
    <script is:inline>
      (function() {
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col font-sans antialiased stitch-bg selection:bg-indigo-500 selection:text-white transition-colors duration-300">
    {/* Header with Category Menus */}
    <header class="sticky top-0 z-50 backdrop-blur-2xl border-b border-[var(--header-border)] transition-all duration-300 shadow-sm dark:shadow-indigo-950/20">
      <div class="container mx-auto px-4 h-16 flex items-center justify-between gap-3">
        {/* Brand Logo */}
        <a href="/" class="flex items-center gap-2.5 group shrink-0">
          <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-tr from-indigo-500/15 via-purple-500/15 to-pink-500/15 border border-indigo-500/30 flex items-center justify-center shadow-md shadow-indigo-500/10 group-hover:scale-105 group-hover:border-purple-500/50 transition-all p-1">
            <img src="/logo.svg" alt="rab8bit 픽셀 토끼 로고" class="w-full h-full object-contain [image-rendering:pixelated] drop-shadow-sm" />
          </div>
          <div class="flex items-baseline gap-1">
            <span class="font-heading font-extrabold text-xl tracking-tight text-slate-900 dark:text-white group-hover:text-indigo-500 transition-colors">
              rab<span class="gradient-text-stitch">8bit</span>
            </span>
          </div>
        </a>

        {/* Category Navigation Links (Visible on Tablet/Desktop) */}
        <nav class="hidden lg:flex items-center gap-0.5 xl:gap-1">
          {navItems.map((item) => {
            const isActive = item.href === '/' 
              ? currentPath === '/' 
              : currentPath.startsWith(item.href);
            
            return (
              <a
                href={item.href}
                class={`px-2 xl:px-2.5 py-1.5 rounded-xl text-xs font-semibold transition-all duration-200 flex items-center gap-1 relative group ${
                  isActive
                    ? 'text-indigo-600 dark:text-indigo-400 font-bold bg-indigo-50 dark:bg-indigo-500/15 border border-indigo-200 dark:border-indigo-500/35 shadow-sm'
                    : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/70'
                }`}
              >
                {item.icon && <span class="text-xs">{item.icon}</span>}
                <span>{item.label}</span>
                {item.badge && (
                  <span class={`text-[9px] px-1.5 py-0.2 rounded-full font-bold uppercase tracking-wider ${
                    item.badge === 'Hot' 
                      ? 'bg-pink-100 dark:bg-pink-500/20 text-pink-600 dark:text-pink-400 border border-pink-200 dark:border-pink-500/30' 
                      : 'bg-indigo-100 dark:bg-indigo-500/20 text-indigo-600 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-500/30'
                  }`}>
                    {item.badge}
                  </span>
                )}
              </a>
            );
          })}
        </nav>

        {/* Right Section: Integrated Search & Dark Mode Toggle Button */}
        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
          {/* Integrated Search Input Form */}
          <form action="/search" method="GET" class="relative flex items-center">
            <input
              type="text"
              name="q"
              placeholder="통합 검색..."
              class="w-32 sm:w-40 md:w-48 bg-slate-100 dark:bg-slate-900/90 text-slate-900 dark:text-slate-200 text-xs rounded-full pl-3.5 pr-7 py-1.5 border border-slate-300 dark:border-slate-700/80 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all placeholder:text-slate-400 shadow-inner"
            />
            <button
              type="submit"
              aria-label="통합 검색 실행"
              class="absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors p-0.5"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-4.35-4.35m0 0a7.5 7.5 0 10-10.6-10.6 7.5 7.5 0 0010.6 10.6z" />
              </svg>
            </button>
          </form>

          {/* Dark / Light Mode Toggle Button */}
          <button
            id="theme-toggle-btn"
            type="button"
            aria-label="다크 모드 / 라이트 모드 전환"
            title="다크 모드 / 라이트 모드 전환"
            class="p-2 rounded-full text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-800/80 hover:text-amber-500 dark:hover:text-amber-400 transition-all focus:outline-none flex items-center justify-center cursor-pointer border border-transparent hover:border-slate-300 dark:hover:border-slate-700"
          >
            {/* Sun Icon (Visible in dark mode) */}
            <svg id="theme-sun-icon" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="4" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41m14.14-14.14l-1.41 1.41" />
            </svg>

            {/* Moon Icon (Visible in light mode) */}
            <svg id="theme-moon-icon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>
        </div>
      </div>

      {/* Sub-Header Mobile Horizontal Scroll Navigation bar (Only on Mobile < 1024px) */}
      <div class="lg:hidden flex items-center gap-1 py-2 px-3 border-t border-[var(--header-border)] bg-[var(--bg-header)] text-xs overflow-x-auto scrollbar-none">
        {navItems.map((item) => {
          const isActive = item.href === '/' 
            ? currentPath === '/' 
            : currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              class={`flex items-center gap-1 py-1 px-2.5 rounded-lg whitespace-nowrap transition-colors text-xs shrink-0 ${
                isActive 
                  ? 'text-indigo-600 dark:text-indigo-400 font-bold bg-indigo-50 dark:bg-indigo-500/15 border border-indigo-200 dark:border-indigo-500/30' 
                  : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 bg-slate-100 dark:bg-slate-900/60'
              }`}
            >
              {item.icon && <span class="text-xs">{item.icon}</span>}
              <span>{item.label}</span>
              {item.badge && (
                <span class="text-[9px] px-1 py-0.2 rounded bg-slate-200 dark:bg-slate-800 text-indigo-700 dark:text-indigo-300 font-semibold">
                  {item.badge}
                </span>
              )}
            </a>
          );
        })}
      </div>
    </header>

    {/* Main Container */}
    <main class="flex-1 container mx-auto px-4 py-8 md:py-12">
      <slot />
    </main>

    {/* Footer */}
    <footer class="border-t border-[var(--footer-border)] bg-[var(--footer-bg)] backdrop-blur-2xl py-12 transition-colors duration-300">
      <div class="container mx-auto px-4 space-y-8">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 pb-8 border-b border-[var(--header-border)]">
          <div class="space-y-2">
            <div class="flex items-center gap-2.5">
              <img src="/logo.svg" alt="rab8bit 로고" class="w-8 h-8 object-contain [image-rendering:pixelated]" />
              <span class="font-heading font-extrabold text-2xl tracking-tight text-slate-900 dark:text-white">
                rab<span class="gradient-text-stitch">8bit</span>
              </span>
            </div>
            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 max-w-md">
              Google Stitch 스타일 네온 디스플레이 & AI 프롬프트 라이브러리와 스마트 유틸리티 툴을 선사합니다.
            </p>
          </div>

          <div class="flex flex-wrap gap-4 text-xs font-semibold text-slate-600 dark:text-slate-400">
            <a href="/about" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">서비스 소개</a>
            <a href="/faq" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">FAQ</a>
            <a href="/terms" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">이용약관</a>
            <a href="/privacy-policy" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">개인정보처리방침</a>
            <a href="/contact" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">문의하기</a>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate-500">
          <p>&copy; {new Date().getFullYear()} rab8bit.com. All rights reserved.</p>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 flex items-center gap-1">
            <span>Powered by Gemini & Stitch UI Engine</span>
          </p>
        </div>
      </div>
    </footer>

    {/* Theme Toggle Client Script */}
    <script is:inline>
      function initThemeToggle() {
        const toggleBtn = document.getElementById('theme-toggle-btn');
        const sunIcon = document.getElementById('theme-sun-icon');
        const moonIcon = document.getElementById('theme-moon-icon');

        function updateUI() {
          const isDark = document.documentElement.classList.contains('dark');
          if (isDark) {
            sunIcon?.classList.remove('hidden');
            moonIcon?.classList.add('hidden');
          } else {
            sunIcon?.classList.add('hidden');
            moonIcon?.classList.remove('hidden');
          }
        }

        updateUI();

        if (toggleBtn) {
          toggleBtn.onclick = function() {
            const isDark = document.documentElement.classList.contains('dark');
            if (isDark) {
              document.documentElement.classList.remove('dark');
              localStorage.setItem('theme', 'light');
            } else {
              document.documentElement.classList.add('dark');
              localStorage.setItem('theme', 'dark');
            }
            updateUI();
          };
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initThemeToggle);
      } else {
        initThemeToggle();
      }
      document.addEventListener('astro:after-swap', initThemeToggle);
    </script>
  </body>
</html>
