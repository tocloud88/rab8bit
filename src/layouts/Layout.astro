---
import SEO from '../components/SEO.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/tools/unit-converter', label: '단위변환기', icon: '📐' },
  { href: '/tools/ladder-game', label: '사다리게임', icon: '🪜' },
  { href: '/news', label: 'AI 뉴스', icon: '📰' },
  { href: '/prompts', label: '프롬프트', icon: '💡' },
];
---

<!doctype html>
<html lang="ko" class="scroll-smooth dark">
  <head>
    <SEO title={title} description={description} />
  </head>
  <body class="min-h-screen text-slate-100 flex flex-col font-sans antialiased stitch-bg selection:bg-indigo-500 selection:text-white">
    {/* Floating Header */}
    <header class="sticky top-0 z-50 backdrop-blur-2xl bg-slate-950/80 border-b border-indigo-500/20 transition-all shadow-xl shadow-indigo-950/20">
      <div class="container mx-auto px-4 h-16 flex items-center justify-between">
        {/* Brand Logo */}
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-500 via-purple-500 to-pink-500 p-0.5 shadow-lg shadow-indigo-500/30 group-hover:scale-105 transition-transform">
            <div class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center font-extrabold text-white text-lg">
              🐰
            </div>
          </div>
          <div class="flex flex-col">
            <span class="font-heading font-extrabold text-xl tracking-tight text-white group-hover:text-indigo-400 transition-colors">
              rab<span class="gradient-text-stitch">8bit</span>
            </span>
          </div>
        </a>

        {/* Navigation Links */}
        <nav class="hidden md:flex items-center gap-1 bg-slate-900/90 p-1.5 rounded-2xl border border-indigo-500/20 shadow-inner">
          {navItems.map((item) => {
            const isActive = currentPath.startsWith(item.href);
            return (
              <a
                href={item.href}
                class={`px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all flex items-center gap-1.5 ${
                  isActive
                    ? 'bg-gradient-to-r from-indigo-600 to-purple-600 text-white shadow-lg shadow-indigo-500/25'
                    : 'text-slate-400 hover:text-white hover:bg-slate-800/60'
                }`}
              >
                <span>{item.icon}</span>
                <span>{item.label}</span>
              </a>
            );
          })}
        </nav>

        {/* CTA Button */}
        <div class="flex items-center gap-3">
          <a
            href="/prompts"
            class="hidden sm:inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 hover:from-indigo-400 hover:to-pink-400 text-white text-xs sm:text-sm font-bold shadow-lg shadow-purple-500/30 transition-all hover:shadow-purple-500/50 hover:scale-105 active:scale-95"
          >
            <span>✨ AI 프롬프트</span>
          </a>
        </div>
      </div>

      {/* Mobile Navigation bar */}
      <div class="md:hidden flex items-center justify-around py-2 px-4 border-t border-slate-800/80 bg-slate-950/95 text-xs">
        {navItems.map((item) => {
          const isActive = currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              class={`flex flex-col items-center gap-0.5 py-1 px-3 rounded-lg ${
                isActive ? 'text-indigo-400 font-bold' : 'text-slate-400'
              }`}
            >
              <span class="text-base">{item.icon}</span>
              <span class="text-[11px]">{item.label}</span>
            </a>
          );
        })}
      </div>
    </header>

    {/* Main Container */}
    <main class="flex-1 container mx-auto px-4 py-8 md:py-12">
      <slot />
    </main>

    {/* Footer */}
    <footer class="border-t border-indigo-500/20 bg-slate-950/90 backdrop-blur-2xl py-12">
      <div class="container mx-auto px-4 space-y-8">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 pb-8 border-b border-slate-800/80">
          <div class="space-y-2">
            <div class="flex items-center gap-2">
              <span class="font-heading font-extrabold text-2xl tracking-tight text-white">
                rab<span class="gradient-text-stitch">8bit</span>
              </span>
            </div>
            <p class="text-xs sm:text-sm text-slate-400 max-w-md">
              Google Stitch 스타일 네온 디스플레이 & AI 프롬프트 라이브러리와 스마트 유틸리티 툴을 선사합니다.
            </p>
          </div>

          <div class="flex flex-wrap gap-4 text-xs font-semibold text-slate-400">
            <a href="/about" class="hover:text-indigo-400 transition-colors">서비스 소개</a>
            <a href="/terms" class="hover:text-indigo-400 transition-colors">이용약관</a>
            <a href="/privacy-policy" class="hover:text-indigo-400 transition-colors">개인정보처리방침</a>
            <a href="/contact" class="hover:text-indigo-400 transition-colors">문의하기</a>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate-500">
          <p>&copy; {new Date().getFullYear()} rab8bit.com. All rights reserved.</p>
          <p class="text-[11px] text-slate-400 flex items-center gap-1">
            <span>Powered by Gemini & Stitch UI Engine</span>
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
