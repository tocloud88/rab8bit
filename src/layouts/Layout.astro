---
import SEO from '../components/SEO.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: '홈', icon: '🏠' },
  { href: '/blog', label: '블로그', badge: '56+' },
  { href: '/insights', label: '인사이트', badge: '93' },
  { href: '/tools', label: '프로그램', badge: '130+' },
  { href: '/prompts', label: '프롬프트', badge: '274' },
  { href: '/gpts', label: '챗봇지침', badge: '100' },
  { href: '/gallery', label: '바나나 갤러리', icon: '🍌' },
  { href: '/ai-tools', label: 'AI 도구', badge: '152+' },
  { href: '/ebooks', label: '전자책' },
  { href: '/faq', label: 'FAQ' },
];
---

<!doctype html>
<html lang="ko" class="scroll-smooth">
  <head>
    <SEO title={title} description={description} />
    <script is:inline>
      (function() {
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col font-sans antialiased stitch-bg selection:bg-indigo-500 selection:text-white transition-colors duration-300">
    {/* Header with Category Menus */}
    <header class="sticky top-0 z-50 backdrop-blur-2xl border-b border-[var(--header-border)] transition-all duration-300 shadow-sm dark:shadow-indigo-950/20">
      <div class="container mx-auto px-4 h-16 flex items-center justify-between gap-3">
        {/* Brand Logo */}
        <a href="/" class="flex items-center gap-2.5 group shrink-0">
          <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-tr from-indigo-500/15 via-purple-500/15 to-pink-500/15 border border-indigo-500/30 flex items-center justify-center shadow-md shadow-indigo-500/10 group-hover:scale-105 group-hover:border-purple-500/50 transition-all p-1">
            <img src="/logo.svg" alt="rab8bit 픽셀 토끼 로고" class="w-full h-full object-contain [image-rendering:pixelated] drop-shadow-sm" />
          </div>
          <div class="flex items-baseline gap-1">
            <span class="font-heading font-extrabold text-xl tracking-tight text-slate-900 dark:text-white group-hover:text-indigo-500 transition-colors">
              rab<span class="gradient-text-stitch">8bit</span>
            </span>
          </div>
        </a>

        {/* Category Navigation Links (Visible on Tablet/Desktop) */}
        <nav class="hidden lg:flex items-center gap-0.5 xl:gap-1">
          {navItems.map((item) => {
            const isActive = item.href === '/' 
              ? currentPath === '/' 
              : currentPath.startsWith(item.href);
            
            return (
              <a
                href={item.href}
                class={`px-2 xl:px-2.5 py-1.5 rounded-xl text-xs font-semibold transition-all duration-200 flex items-center gap-1 relative group ${
                  isActive
                    ? 'text-indigo-600 dark:text-indigo-400 font-bold bg-indigo-50 dark:bg-indigo-500/15 border border-indigo-200 dark:border-indigo-500/35 shadow-sm'
                    : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/70'
                }`}
              >
                {item.icon && <span class="text-xs">{item.icon}</span>}
                <span>{item.label}</span>
                {item.badge && (
                  <span class={`text-[9px] px-1.5 py-0.2 rounded-full font-bold uppercase tracking-wider ${
                    item.badge === 'Hot' 
                      ? 'bg-pink-100 dark:bg-pink-500/20 text-pink-600 dark:text-pink-400 border border-pink-200 dark:border-pink-500/30' 
                      : 'bg-indigo-100 dark:bg-indigo-500/20 text-indigo-600 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-500/30'
                  }`}>
                    {item.badge}
                  </span>
                )}
              </a>
            );
          })}
        </nav>

        {/* Right Section: Integrated Search & Dark Mode Toggle Button */}
        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
          {/* Integrated Search Input Form */}
          <form action="/search" method="GET" class="relative flex items-center">
            <input
              type="text"
              name="q"
              placeholder="통합 검색..."
              class="w-32 sm:w-40 md:w-48 bg-slate-100 dark:bg-slate-900/90 text-slate-900 dark:text-slate-200 text-xs rounded-full pl-3.5 pr-7 py-1.5 border border-slate-300 dark:border-slate-700/80 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all placeholder:text-slate-400 shadow-inner"
            />
            <button
              type="submit"
              aria-label="통합 검색 실행"
              class="absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors p-0.5"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-4.35-4.35m0 0a7.5 7.5 0 10-10.6-10.6 7.5 7.5 0 0010.6 10.6z" />
              </svg>
            </button>
          </form>

          {/* Dark / Light Mode Toggle Button */}
          <button
            id="theme-toggle-btn"
            type="button"
            aria-label="다크 모드 / 라이트 모드 전환"
            title="다크 모드 / 라이트 모드 전환"
            class="p-2 rounded-full text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-800/80 hover:text-amber-500 dark:hover:text-amber-400 transition-all focus:outline-none flex items-center justify-center cursor-pointer border border-transparent hover:border-slate-300 dark:hover:border-slate-700"
          >
            {/* Sun Icon (Visible in dark mode) */}
            <svg id="theme-sun-icon" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="4" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41m14.14-14.14l-1.41 1.41" />
            </svg>

            {/* Moon Icon (Visible in light mode) */}
            <svg id="theme-moon-icon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>
        </div>
      </div>

      {/* Sub-Header Mobile Horizontal Scroll Navigation bar (Only on Mobile < 1024px) */}
      <div class="lg:hidden flex items-center gap-1 py-2 px-3 border-t border-[var(--header-border)] bg-[var(--bg-header)] text-xs overflow-x-auto scrollbar-none">
        {navItems.map((item) => {
          const isActive = item.href === '/' 
            ? currentPath === '/' 
            : currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              class={`flex items-center gap-1 py-1 px-2.5 rounded-lg whitespace-nowrap transition-colors text-xs shrink-0 ${
                isActive 
                  ? 'text-indigo-600 dark:text-indigo-400 font-bold bg-indigo-50 dark:bg-indigo-500/15 border border-indigo-200 dark:border-indigo-500/30' 
                  : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 bg-slate-100 dark:bg-slate-900/60'
              }`}
            >
              {item.icon && <span class="text-xs">{item.icon}</span>}
              <span>{item.label}</span>
              {item.badge && (
                <span class="text-[9px] px-1 py-0.2 rounded bg-slate-200 dark:bg-slate-800 text-indigo-700 dark:text-indigo-300 font-semibold">
                  {item.badge}
                </span>
              )}
            </a>
          );
        })}
      </div>
    </header>

    {/* Main Container */}
    <main class="flex-1 container mx-auto px-4 py-8 md:py-12">
      <slot />
    </main>

    {/* Footer */}
    <footer class="border-t border-[var(--footer-border)] bg-[var(--footer-bg)] backdrop-blur-2xl pt-14 pb-12 transition-colors duration-300">
      <div class="container mx-auto px-4 space-y-12">
        {/* Brand & Mission Banner */}
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 pb-8 border-b border-[var(--header-border)]">
          <div class="space-y-2">
            <a href="/" class="flex items-center gap-2.5 group inline-flex">
              <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-indigo-500/15 via-purple-500/15 to-pink-500/15 border border-indigo-500/30 flex items-center justify-center p-1 group-hover:scale-105 transition-all">
                <img src="/logo.svg" alt="rab8bit 로고" class="w-full h-full object-contain [image-rendering:pixelated]" />
              </div>
              <span class="font-heading font-extrabold text-2xl tracking-tight text-slate-900 dark:text-white">
                rab<span class="gradient-text-stitch">8bit</span>
              </span>
            </a>
            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 max-w-xl leading-relaxed">
              최신 AI 인사이트, 370+ 검증된 프롬프트와 GPTs 지침, 130+ 인터랙티브 스마트 도구 및 엄선된 AI 디렉토리를 제공하는 올인원 플랫폼입니다.
            </p>
          </div>

          <div class="flex items-center gap-2">
            <a
              href="/search"
              class="px-3.5 py-2 rounded-xl bg-slate-100 dark:bg-slate-900/80 hover:bg-indigo-600 dark:hover:bg-indigo-600 text-slate-700 dark:text-slate-300 hover:text-white text-xs font-bold border border-slate-200 dark:border-indigo-500/20 transition-all flex items-center gap-1.5"
            >
              <span>🔍</span> 전체 통합 검색
            </a>
            <a
              href="/tools"
              class="px-3.5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-md shadow-indigo-500/20 transition-all flex items-center gap-1.5"
            >
              <span>⚡</span> 스마트 도구 전체보기 (130+)
            </a>
          </div>
        </div>

        {/* Multi-Column OpenAI Style Sitemap Grid */}
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-8 text-xs">
          {/* Column 1: AI 콘텐츠 & 리서치 */}
          <div class="space-y-3.5">
            <h4 class="font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider text-[13px] flex items-center gap-1.5">
              <span>📚</span> 콘텐츠 & 리서치
            </h4>
            <ul class="space-y-2.5">
              <li>
                <a href="/blog" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors flex items-center justify-between">
                  <span>블로그 아티클</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-indigo-500/10 text-indigo-500 font-bold">56</span>
                </a>
              </li>
              <li>
                <a href="/insights" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors flex items-center justify-between">
                  <span>영상 인사이트</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-purple-500/10 text-purple-500 font-bold">93</span>
                </a>
              </li>
              <li>
                <a href="/prompts" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors flex items-center justify-between">
                  <span>프롬프트 라이브러리</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-pink-500/10 text-pink-500 font-bold">274</span>
                </a>
              </li>
              <li>
                <a href="/gpts" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors flex items-center justify-between">
                  <span>GPTs 맞춤 지침</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-500 font-bold">100</span>
                </a>
              </li>
              <li>
                <a href="/ebooks" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  실무 AI 전자책
                </a>
              </li>
            </ul>
          </div>

          {/* Column 2: AI 도구 & 갤러리 */}
          <div class="space-y-3.5">
            <h4 class="font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider text-[13px] flex items-center gap-1.5">
              <span>🤖</span> AI 에코시스템
            </h4>
            <ul class="space-y-2.5">
              <li>
                <a href="/blog/ai-big-4-comparison-chatgpt-gemini-claude-grok" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors flex items-center gap-1">
                  <span>AI 빅4 완벽 비교</span>
                  <span class="text-[9px] px-1 py-0.2 rounded bg-rose-500/15 text-rose-500 font-bold">HOT</span>
                </a>
              </li>
              <li>
                <a href="/ai-tools" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors flex items-center justify-between">
                  <span>추천 AI 도구 디렉토리</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-500 font-bold">152+</span>
                </a>
              </li>
              <li>
                <a href="/gallery" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors flex items-center gap-1">
                  <span>🍌 바나나 이미지 갤러리</span>
                </a>
              </li>
              <li>
                <a href="/blog/openai-gpt-6-astra-release-analysis" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors flex items-center gap-1">
                  <span>GPT-6 Astra 분석</span>
                  <span class="text-[9px] px-1 py-0.2 rounded bg-rose-500/15 text-rose-500 font-bold">NEW</span>
                </a>
              </li>
              <li>
                <a href="/blog/ai-self-explanation-verification-guide" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  AI 자기 설명 검증법
                </a>
              </li>
              <li>
                <a href="/blog/vibe-coding-google-ai-studio-auth" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  바이브 코딩 가이드
                </a>
              </li>
            </ul>
          </div>

          {/* Column 3: 인기 생활 유틸리티 */}
          <div class="space-y-3.5">
            <h4 class="font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider text-[13px] flex items-center gap-1.5">
              <span>🛠️</span> 스마트 생활 도구
            </h4>
            <ul class="space-y-2.5">
              <li>
                <a href="/tools/lotto-generator" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  로또 번호 생성기
                </a>
              </li>
              <li>
                <a href="/tools/age-calculator" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  만 나이 & D-Day 계산기
                </a>
              </li>
              <li>
                <a href="/tools/qr-code" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  QR 코드 생성기
                </a>
              </li>
              <li>
                <a href="/tools/barcode-generator" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  바코드 생성기
                </a>
              </li>
              <li>
                <a href="/tools/unit-converter" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  단위 변환기
                </a>
              </li>
              <li>
                <a href="/tools/lunar-converter" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  음양력 변환기
                </a>
              </li>
            </ul>
          </div>

          {/* Column 4: 개발자 & 텍스트 도구 */}
          <div class="space-y-3.5">
            <h4 class="font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider text-[13px] flex items-center gap-1.5">
              <span>💻</span> 개발자 유틸리티
            </h4>
            <ul class="space-y-2.5">
              <li>
                <a href="/tools/json-formatter" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  JSON 포맷터 & 검증기
                </a>
              </li>
              <li>
                <a href="/tools/jwt-decoder" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  JWT 토큰 디코더
                </a>
              </li>
              <li>
                <a href="/tools/base64-encoder" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  Base64 인코더 / 디코더
                </a>
              </li>
              <li>
                <a href="/tools/url-encoder" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  URL 인코더 / 디코더
                </a>
              </li>
              <li>
                <a href="/tools/cron-parser" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  크론(Cron) 표현식 분석기
                </a>
              </li>
              <li>
                <a href="/tools/my-ip" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  내 공인 IP 확인
                </a>
              </li>
            </ul>
          </div>

          {/* Column 5: 인터랙티브 & 게임 */}
          <div class="space-y-3.5">
            <h4 class="font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider text-[13px] flex items-center gap-1.5">
              <span>🎮</span> 인터랙티브 & 게임
            </h4>
            <ul class="space-y-2.5">
              <li>
                <a href="/tools/ladder-game" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  사다리 타기 게임
                </a>
              </li>
              <li>
                <a href="/tools/roulette" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  돌림판 룰렛 게임
                </a>
              </li>
              <li>
                <a href="/tools/speed-quiz" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  스피드 퀴즈 & 초성 게임
                </a>
              </li>
              <li>
                <a href="/tools/qna-a-day" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  하루 한 질문 문답
                </a>
              </li>
              <li>
                <a href="/tools/birthday-secret" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  생일의 비밀 알아보기
                </a>
              </li>
              <li>
                <a href="/tools/cheer" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  오늘의 응원 한마디
                </a>
              </li>
            </ul>
          </div>

          {/* Column 6: 안내 및 정책 */}
          <div class="space-y-3.5">
            <h4 class="font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider text-[13px] flex items-center gap-1.5">
              <span>ℹ️</span> 안내 및 정책
            </h4>
            <ul class="space-y-2.5">
              <li>
                <a href="/about" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  서비스 소개 (About)
                </a>
              </li>
              <li>
                <a href="/faq" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  자주 묻는 질문 (FAQ)
                </a>
              </li>
              <li>
                <a href="/contact" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  문의하기 (Contact)
                </a>
              </li>
              <li>
                <a href="/terms" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  이용약관
                </a>
              </li>
              <li>
                <a href="/privacy-policy" class="text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                  개인정보처리방침
                </a>
              </li>
            </ul>
          </div>
        </div>

        {/* Bottom Copyright & Status */}
        <div class="pt-8 border-t border-[var(--header-border)] flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate-500 dark:text-slate-400">
          <p>&copy; {new Date().getFullYear()} rab8bit.com. All rights reserved.</p>
          <div class="flex items-center gap-2 text-[11px]">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>All Services Operational</span>
          </div>
        </div>
      </div>
    </footer>

    {/* Theme Toggle Client Script */}
    <script is:inline>
      function initThemeToggle() {
        const toggleBtn = document.getElementById('theme-toggle-btn');
        const sunIcon = document.getElementById('theme-sun-icon');
        const moonIcon = document.getElementById('theme-moon-icon');

        function updateUI() {
          const isDark = document.documentElement.classList.contains('dark');
          if (isDark) {
            sunIcon?.classList.remove('hidden');
            moonIcon?.classList.add('hidden');
          } else {
            sunIcon?.classList.add('hidden');
            moonIcon?.classList.remove('hidden');
          }
        }

        updateUI();

        if (toggleBtn) {
          toggleBtn.onclick = function() {
            const isDark = document.documentElement.classList.contains('dark');
            if (isDark) {
              document.documentElement.classList.remove('dark');
              localStorage.setItem('theme', 'light');
            } else {
              document.documentElement.classList.add('dark');
              localStorage.setItem('theme', 'dark');
            }
            updateUI();
          };
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initThemeToggle);
      } else {
        initThemeToggle();
      }
      document.addEventListener('astro:after-swap', initThemeToggle);
    </script>
  </body>
</html>
