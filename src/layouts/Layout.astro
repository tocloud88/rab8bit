---
import SEO from '../components/SEO.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: '홈', icon: '🏠' },
  { href: '/blog', label: '블로그', badge: '54+' },
  { href: '/insights', label: '인사이트', badge: '91' },
  { href: '/tools', label: '프로그램', badge: '130+' },
  { href: '/prompts', label: '프롬프트', badge: '274' },
  { href: '/gpts', label: '챗봇지침', badge: '100' },
  { href: '/gallery', label: '바나나 갤러리', icon: '🍌' },
  { href: '/ai-tools', label: 'AI 도구', badge: '152+' },
  { href: '/ebooks', label: '전자책' },
  { href: '/faq', label: 'FAQ' },
];
---

<!doctype html>
<html lang="ko" class="scroll-smooth dark">
  <head>
    <SEO title={title} description={description} />
  </head>
  <body class="min-h-screen text-slate-100 flex flex-col font-sans antialiased stitch-bg selection:bg-indigo-500 selection:text-white">
    {/* Header with Category Menus */}
    <header class="sticky top-0 z-50 backdrop-blur-2xl bg-slate-950/90 border-b border-indigo-500/20 transition-all shadow-xl shadow-indigo-950/20">
      <div class="container mx-auto px-4 h-16 flex items-center justify-between gap-3">
        {/* Brand Logo */}
        <a href="/" class="flex items-center gap-2.5 group shrink-0">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-500 via-purple-500 to-pink-500 p-0.5 shadow-lg shadow-indigo-500/30 group-hover:scale-105 transition-transform">
            <div class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center font-extrabold text-white text-base">
              🐰
            </div>
          </div>
          <div class="flex items-baseline gap-1">
            <span class="font-heading font-extrabold text-xl tracking-tight text-white group-hover:text-indigo-400 transition-colors">
              rab<span class="gradient-text-stitch">8bit</span>
            </span>
          </div>
        </a>

        {/* Category Navigation Links */}
        <nav class="hidden xl:flex items-center gap-1">
          {navItems.map((item) => {
            const isActive = item.href === '/' 
              ? currentPath === '/' 
              : currentPath.startsWith(item.href);
            
            return (
              <a
                href={item.href}
                class={`px-2.5 py-1.5 rounded-xl text-xs font-semibold transition-all duration-200 flex items-center gap-1 relative group ${
                  isActive
                    ? 'text-indigo-400 font-bold bg-indigo-500/15 border border-indigo-500/35 shadow-sm'
                    : 'text-slate-300 hover:text-white hover:bg-slate-800/70'
                }`}
              >
                {item.icon && <span class="text-xs">{item.icon}</span>}
                <span>{item.label}</span>
                {item.badge && (
                  <span class={`text-[9px] px-1.5 py-0.2 rounded-full font-bold uppercase tracking-wider ${
                    item.badge === 'Hot' 
                      ? 'bg-pink-500/20 text-pink-400 border border-pink-500/30' 
                      : 'bg-indigo-500/20 text-indigo-300 border border-indigo-500/30'
                  }`}>
                    {item.badge}
                  </span>
                )}
              </a>
            );
          })}
        </nav>

        {/* Right Section: Integrated Search & Quick Actions */}
        <div class="flex items-center gap-2">
          {/* AI Prompt CTA */}
          <a
            href="/prompts"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 hover:from-indigo-400 hover:to-pink-400 text-white text-xs font-bold shadow-md shadow-purple-500/20 transition-all hover:scale-105 active:scale-95 shrink-0"
          >
            <span>✨ 프롬프트</span>
          </a>
        </div>
      </div>

      {/* Sub-Header Mobile/Tablet Horizontal Scroll Navigation bar */}
      <div class="xl:hidden flex items-center gap-1 py-2 px-3 border-t border-slate-800/80 bg-slate-950/95 text-xs overflow-x-auto scrollbar-none">
        {navItems.map((item) => {
          const isActive = item.href === '/' 
            ? currentPath === '/' 
            : currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              class={`flex items-center gap-1 py-1 px-2.5 rounded-lg whitespace-nowrap transition-colors text-xs shrink-0 ${
                isActive ? 'text-indigo-400 font-bold bg-indigo-500/15 border border-indigo-500/30' : 'text-slate-400 hover:text-slate-200 bg-slate-900/60'
              }`}
            >
              {item.icon && <span class="text-xs">{item.icon}</span>}
              <span>{item.label}</span>
              {item.badge && (
                <span class="text-[9px] px-1 py-0.2 rounded bg-slate-800 text-indigo-300 font-semibold">
                  {item.badge}
                </span>
              )}
            </a>
          );
        })}
      </div>
    </header>

    {/* Main Container */}
    <main class="flex-1 container mx-auto px-4 py-8 md:py-12">
      <slot />
    </main>

    {/* Footer */}
    <footer class="border-t border-indigo-500/20 bg-slate-950/90 backdrop-blur-2xl py-12">
      <div class="container mx-auto px-4 space-y-8">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 pb-8 border-b border-slate-800/80">
          <div class="space-y-2">
            <div class="flex items-center gap-2">
              <span class="font-heading font-extrabold text-2xl tracking-tight text-white">
                rab<span class="gradient-text-stitch">8bit</span>
              </span>
            </div>
            <p class="text-xs sm:text-sm text-slate-400 max-w-md">
              Google Stitch 스타일 네온 디스플레이 & AI 프롬프트 라이브러리와 스마트 유틸리티 툴을 선사합니다.
            </p>
          </div>

          <div class="flex flex-wrap gap-4 text-xs font-semibold text-slate-400">
            <a href="/about" class="hover:text-indigo-400 transition-colors">서비스 소개</a>
            <a href="/faq" class="hover:text-indigo-400 transition-colors">FAQ</a>
            <a href="/terms" class="hover:text-indigo-400 transition-colors">이용약관</a>
            <a href="/privacy-policy" class="hover:text-indigo-400 transition-colors">개인정보처리방침</a>
            <a href="/contact" class="hover:text-indigo-400 transition-colors">문의하기</a>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate-500">
          <p>&copy; {new Date().getFullYear()} rab8bit.com. All rights reserved.</p>
          <p class="text-[11px] text-slate-400 flex items-center gap-1">
            <span>Powered by Gemini & Stitch UI Engine</span>
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
